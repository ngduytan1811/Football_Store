@model FBS.Infrastructure.Entities.Order

@using FBS.Shared.Enums
@using FBS.Shared.Helpers

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="card p-4 shadow-sm">

        <h3 class="fw-bold mb-3">Chi tiết đơn hàng</h3>

        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

     
        <div class="mb-4">
            <p><b>Tên khách:</b> @Model.CustomerName</p>
            <p><b>Số điện thoại:</b> @Model.CustomerPhone</p>
            <p><b>Email:</b> @Model.CustomerEmail</p>
            <p><b>Địa chỉ:</b> @Model.CustomerAddress</p>
            <p><b>Ghi chú:</b> @Model.Note</p>
        </div>

        <hr />

        
        <h5 class="fw-bold mb-3">Trạng thái đơn hàng</h5>

        <form asp-action="UpdateStatus" asp-controller="Order" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="d-flex gap-3 align-items-center">
                <select name="status" class="form-select" style="width:250px;">
                    @foreach (StatusEnum st in Enum.GetValues(typeof(StatusEnum)))
                    {
                        <option value="@st" selected="@(Model.Status == st)">
                            @st.GetDisplayName()
                        </option>
                    }
                </select>

                <button type="submit" class="btn btn-primary">
                    Cập nhật
                </button>
            </div>
        </form>

        <hr />

 
        <h5 class="fw-bold mb-3">Danh sách sản phẩm</h5>

        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Size</th>
                    <th>Màu</th>
                    <th>SL</th>
                    <th>Giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    var sub = (item.Price ?? 0) * (item.Quantity ?? 0);
                    <tr>
                        <td>
                            <img src="@Url.Content("~/theme/client/img/product/" + item.Product.Image)"
                                 style="width:80px;height:80px;object-fit:cover;border-radius:6px;" />
                        </td>
                        <td>@item.Product?.Name</td>
                        <td>@item.ProductSize</td>
                        <td>@item.ProductColor</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price?.ToString("N0") đ</td>
                        <td>@sub.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Tổng tiền -->
        <div class="text-end mt-3">
            <h4 class="fw-bold text-primary">
                Tổng tiền: @(Model.OrderItems.Sum(x => (x.Price ?? 0) * (x.Quantity ?? 0)).ToString("N0")) đ

            </h4>
        </div>

        <a href="/admin/Order" class="btn btn-secondary mt-4">Quay lại</a>

    </div>
</div>
