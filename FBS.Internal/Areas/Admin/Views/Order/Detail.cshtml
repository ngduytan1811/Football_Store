@model FBS.Infrastructure.Entities.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="card p-4">

        <h3 class="fw-bold mb-3">Chi tiết đơn hàng</h3>

        <!-- Thông tin khách hàng -->
        <div class="mb-4">
            <p><b>Tên khách:</b> @Model.CustomerName</p>
            <p><b>Số điện thoại:</b> @Model.CustomerPhone</p>
            <p><b>Email:</b> @Model.CustomerEmail</p>
            <p><b>Địa chỉ:</b> @Model.CustomerAddress</p>
            <p><b>Ghi chú:</b> @Model.Note</p>
        </div>

        <hr />

        <!-- Sản phẩm -->
        <h5 class="fw-bold mb-3">Danh sách sản phẩm</h5>

        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Size</th>
                    <th>Màu</th>
                    <th>SL</th>
                    <th>Giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    var sub = (item.Price ?? 0) * (item.Quantity ?? 0);
                    <tr>
                        <td>
                            <img src="~/uploads/products/@item.Product?.Image"
                                 style="width:70px; height:70px; object-fit:cover"
                                 class="rounded border" />
                        </td>
                        <td>@item.Product?.Name</td>
                        <td>@item.ProductSize</td>
                        <td>@item.ProductColor</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price?.ToString("N0") đ</td>
                        <td>@sub.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Tổng tiền -->
        <div class="text-end mt-3">
            <h4 class="fw-bold text-primary">
                Tổng tiền: @Model.OrderItems.Sum(x => (x.Price ?? 0) * (x.Quantity ?? 0)).ToString("N0") đ
            </h4>
        </div>

        <a href="/admin/Order" class="btn btn-secondary mt-4">Quay lại</a>

    </div>
</div>
