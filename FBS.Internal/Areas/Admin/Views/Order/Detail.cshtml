@model FBS.Infrastructure.Entities.Order

@using FBS.Shared.Enums
@using FBS.Shared.Helpers

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid">
    <div class="card p-4 shadow-sm">

        <h3 class="fw-bold mb-3">Chi tiết đơn hàng</h3>

        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

     
        <div class="mb-4">
            <p><b>Tên khách:</b> @Model.CustomerName</p>
            <p><b>Số điện thoại:</b> @Model.CustomerPhone</p>
            <p><b>Email:</b> @Model.CustomerEmail</p>
            <p><b>Địa chỉ:</b> @Model.CustomerAddress</p>
            <p><b>Ghi chú:</b> @Model.Note</p>
        </div>

        <hr />
        <div class="mb-4">
            <h5 class="fw-bold mb-2">Thông tin thanh toán</h5>

            <p>
                <b>Phương thức:</b>
                @if (Model.PaymentMethod == "COD")
                {
                    <span class="badge bg-info">COD</span>
                }
                else
                {
                    <span class="badge bg-warning">VietQR</span>
                }
            </p>

            <p>
                <b>Trạng thái thanh toán:</b>
                @if (Model.PaymentStatus == PaymentStatusEnum.Paid)
                {
                    <span class="badge bg-success">Đã thanh toán</span>
                }
                else
                {
                    <span class="badge bg-secondary">Chưa thanh toán</span>
                }
            </p>


            @if (Model.PaymentMethod == "VietQR"
            && Model.PaymentStatus == PaymentStatusEnum.Unpaid)
            {
                <form asp-action="ConfirmPayment"
                      asp-controller="Order"
                      method="post"
                      onsubmit="return confirm('Xác nhận khách đã thanh toán VietQR?');">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <button class="btn btn-success">
                        Xác nhận đã thanh toán VietQR
                    </button>
                </form>
            }

        </div>


        
        <h5 class="fw-bold mb-3">Trạng thái đơn hàng</h5>

        <form asp-area="Admin"asp-controller="AdminOrder"asp-action="UpdateStatus"method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <select name="status" class="form-select" style="width:250px;">
                @foreach (StatusEnum st in Enum.GetValues(typeof(StatusEnum)))
                {
                    <option value="@st" selected="@(Model.Status == st)">
                        @st.GetDisplayName()
                    </option>
                }
            </select>

            <button class="btn btn-primary">
                Cập nhật
            </button>
        </form>


        <hr />

        <h5 class="fw-bold mb-3">Danh sách sản phẩm</h5>

        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Size</th>
                    <th>Màu</th>
                    <th>SL</th>
                    <th>Giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    var sub = (item.Price ?? 0) * (item.Quantity ?? 0);
                    <tr>
                        <td>
                            <img src="@Url.Content("~/theme/client/img/product/" + item.Product.Image)"
                                 style="width:80px;height:80px;object-fit:cover;border-radius:6px;" />
                        </td>
                        <td>@item.Product?.Name</td>
                        <td>@item.ProductSize</td>
                        <td>@item.ProductColor</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price?.ToString("N0") đ</td>
                        <td>@sub.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Tổng tiền -->
        <div class="text-end mt-3">
            <h4 class="fw-bold text-primary">
                <p><b>Phí vận chuyển:</b> @Model.ShippingFee.ToString("N0") đ</p>
                <p><b>Tổng tiền:</b> @Model.TotalAmount.ToString("N0") đ</p>


            </h4>
        </div>

        <a href="/admin/Order" class="btn btn-secondary mt-4">Quay lại</a>

    </div>
</div>
