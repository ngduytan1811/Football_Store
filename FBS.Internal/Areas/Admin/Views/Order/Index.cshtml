@model List<FBS.Infrastructure.Entities.Order>
@using FBS.Shared.Enums
@using FBS.Shared.Helpers

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid basic_table">
    <div class="row">
        <div class="col-sm-12">

            <div class="card shadow-sm border-0 px-4">

                <div class="d-flex justify-content-between align-items-center py-3 mb-3 border-bottom">
                    <h4 class="fw-bold mb-0" style="cursor:pointer;" onclick="window.location.href='/admin/Order'">
                        Quản lý đơn hàng
                    </h4>



    <form method="get" class="d-flex align-items-center gap-2">

        <!-- Lọc trạng thái -->
        <select name="status" class="form-select" style="width: 170px;">
            <option value="">Tất cả trạng thái</option>
            @foreach (StatusEnum st in Enum.GetValues(typeof(StatusEnum)))
            {
                                <option value="@st" selected="@(ViewBag.Status != null && ViewBag.Status.ToString() == st.ToString())">
                                    @st.GetDisplayName()
                                </option>

            }
        </select>

        <!-- Từ ngày -->
        <input type="date" name="fromDate" value="@ViewBag.FromDate"
               class="form-control" style="width: 180px;" />

        <!-- Đến ngày -->
        <input type="date" name="toDate" value="@ViewBag.ToDate"
               class="form-control" style="width: 180px;" />

        <!-- Từ khóa -->
        <input type="text" name="keyword" value="@ViewBag.Keyword"
               class="form-control" style="width: 230px;"
               placeholder="Tên, SĐT, mã đơn..." />

        <button class="btn btn-primary px-3">Tìm</button>

    </form>
                   

</div>
                <div class="d-flex gap-3 mt-3 mb-4">

                    <div class="p-3 rounded-3 shadow-sm text-center" style="width:160px; background:#eef3ff;">
                        <div class="fw-bold" style="font-size:22px;">@ViewBag.TotalOrders</div>
                        <small class="text-muted">Tổng đơn</small>
                    </div>

                    <div class="p-3 rounded-3 shadow-sm text-center" style="width:160px; background:#fff7e6;">
                        <div class="fw-bold" style="font-size:22px;">@ViewBag.TotalPending</div>
                        <small class="text-muted">Chờ xác nhận</small>
                    </div>

                    <div class="p-3 rounded-3 shadow-sm text-center" style="width:160px; background:#f3e8ff;">
                        <div class="fw-bold" style="font-size:22px;">@ViewBag.TotalProcessing</div>
                        <small class="text-muted">Đang xử lý</small>
                    </div>

                    <div class="p-3 rounded-3 shadow-sm text-center" style="width:160px; background:#e6fffb;">
                        <div class="fw-bold" style="font-size:22px;">@ViewBag.TotalShipping</div>
                        <small class="text-muted">Đang giao</small>
                    </div>

                    <div class="p-3 rounded-3 shadow-sm text-center" style="width:160px; background:#ffe7eb;">
                        <div class="fw-bold" style="font-size:22px;">@ViewBag.TotalSuccess</div>
                        <small class="text-muted">Giao thành công</small>
                    </div>

                    <div class="p-3 rounded-3 shadow-sm text-center" style="width:160px; background:#fff1f0;">
                        <div class="fw-bold" style="font-size:22px;">@ViewBag.TotalCanceled</div>
                        <small class="text-muted">Đã hủy</small>
                    </div>

                </div>




                @if (TempData["SearchError"] != null)
                {
                    <div class="alert alert-warning mt-3 fw-semibold" style="border-radius:8px;">
                        @TempData["SearchError"]
                    </div>
                }



                <div class="table-responsive theme-scrollbar py-4">
                   

                    <table class="table table-hover table-borderless align-middle">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th>Mã</th>
                                <th>Trạng thái</th>
                                <th>Tên</th>
                                <th>Số điện thoại</th>
                                <th>Địa Chỉ</th>
                                <th>Ngày đặt</th>
                                <th>Chi tiết</th>
                              
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">

                                    <td class="fw-semibold text-primary">
                                        @item.Id
                                    </td>

                                    <td>
                                        @switch (item.Status)
                                        {
                                            case StatusEnum.Inactive:
                                                <span class="badge" style="background:#fff7e6; color:#000;">
                                                    @item.Status.GetDisplayName() @* Chờ Xác Nhận *@
                                                </span>
                                                break;

                                            case StatusEnum.Active:
                                                <span class="badge" style="background:#f3e8ff; color:#000;">
                                                    @item.Status.GetDisplayName() @* Đang Xử Lý *@
                                                </span>
                                                break;

                                            case StatusEnum.InHandler:
                                                <span class="badge" style="background:#e6fffb; color:#000;">
                                                    @item.Status.GetDisplayName() @* Đang Giao *@
                                                </span>
                                                break;

                                            case StatusEnum.WaitingApproval:
                                                <span class="badge" style="background:#d4edda; color:#000;">
                                                    @item.Status.GetDisplayName() @* Giao Thành Công *@
                                                </span>
                                                break;

                                            case StatusEnum.Cancel:
                                                <span class="badge" style="background:#fff1f0; color:#000;">
                                                    @item.Status.GetDisplayName() @* Đã Hủy *@
                                                </span>
                                                break;

                                            case StatusEnum.NotSeen:
                                                <span class="badge" style="background:#e2e3e5; color:#000;">
                                                    @item.Status.GetDisplayName() @* Trả Hàng *@
                                                </span>
                                                break;

                                            case StatusEnum.Watched:
                                                <span class="badge" style="background:#f8d7da; color:#000;">
                                                    @item.Status.GetDisplayName() @* Thất Bại *@
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-light text-dark">
                                                    @item.Status
                                                </span>
                                                break;
                                        }


                                    </td>


                                    <td>@item.CustomerName</td>
                                    <td>@item.CustomerPhone</td>
                                    <td>@item.CustomerAddress</td>
                                    <td>@item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="/admin/Order/Detail/@item.Id">
                                            Xem →
                                        </a>
                                    </td>
                                   

                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f8ff !important;
        transition: 0.2s;
    }

    .badge {
        padding: 6px 10px;
        font-size: 13px;
        border-radius: 6px;
    }

    .stats-card {
        transition: 0.3s;
        cursor: pointer;
    }

        .stats-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.1) !important;
        }
</style>
