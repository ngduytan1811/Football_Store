<!DOCTYPE html>
<html lang="vi">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="~/theme/admin/images/favicon/favicon.png" type="image/x-icon">
    <link rel="shortcut icon" href="~/theme/admin/images/favicon/favicon.png" type="image/x-icon">
    <title>Thoc Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/vendors/font-awesome.css">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/vendors/icofont.css">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/vendors/themify.css">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/vendors/flag-icon.css">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/vendors/feather-icon.css">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/vendors/scrollbar.css">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/vendors/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/style.css">
    <link id="color" rel="stylesheet" href="~/theme/admin/css/color-1.css" media="screen">
    <link rel="stylesheet" type="text/css" href="~/theme/admin/css/responsive.css">
</head>
<body onload="startTime()">
    <!-- tap on top starts-->
    <div class="tap-top"><i data-feather="chevrons-up"></i></div>
    <!-- tap on tap ends-->
    <!-- Loader starts-->
    <div class="loader-wrapper">
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"></div>
        <div class="dot"> </div>
        <div class="dot"></div>
    </div>
    <!-- Loader ends-->
    <!-- page-wrapper Start-->
    <div class="page-wrapper compact-wrapper" id="pageWrapper">
        <!-- Page Header Start-->
       @Html.Partial("_Header")
        <!-- Page Header Ends-->
        <!-- Page Body Start-->
        <div class="page-body-wrapper">
            <!-- Page Sidebar Start-->
            @Html.Partial("_Sidebar")
            <!-- Page Sidebar Ends-->
            <div class="page-body">
                @Html.Partial("_PageTitle")
                <!-- Container-fluid starts-->
                <div class="container-fluid dashboard-default">
                   @RenderBody()
                </div>
                <!-- Container-fluid Ends-->
            </div>
            <!-- footer start-->
            @Html.Partial("_Footer")
        </div>
    </div>
    <script src="~/theme/admin/js/jquery-3.6.0.min.js"></script>
    <script src="~/theme/admin/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/theme/admin/js/icons/feather-icon/feather.min.js"></script>
    <script src="~/theme/admin/js/icons/feather-icon/feather-icon.js"></script>
    <script src="~/theme/admin/js/scrollbar/simplebar.js"></script>
    <script src="~/theme/admin/js/scrollbar/custom.js"></script>
    <script src="~/theme/admin/js/config.js"></script>
    <script src="~/theme/admin/js/sidebar-menu.js"></script>
    <script src="~/theme/admin/js/clipboard/clipboard.min.js"></script>
    <script src="~/theme/admin/js/custom-card/custom-card.js"></script>
    <script src="~/theme/admin/js/notify/bootstrap-notify.min.js"></script>
    <script src="~/theme/admin/js/notify/index.js"></script>
    <script src="~/theme/admin/js/typeahead/handlebars.js"></script>
    <script src="~/theme/admin/js/typeahead/typeahead.bundle.js"></script>
    <script src="~/theme/admin/js/typeahead/typeahead.custom.js"></script>
    <script src="~/theme/admin/js/typeahead-search/handlebars.js"></script>
    <script src="~/theme/admin/js/typeahead-search/typeahead-custom.js"></script>
    <script src="~/theme/admin/js/script.js"></script>
    <script src="~/theme/admin/js/theme-customizer/customizer.js">  </script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>