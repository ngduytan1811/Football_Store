@model FBS.Application.DataTranferObjects.Auth.ForgotPasswordDto

@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Areas/Admin/Views/Shared/_EmptyLayout.cshtml";
}

<div class="row m-0">
    <div class="col-12 p-0">
        <div class="login-card">
            <div class="login-main">
                <form asp-action="ForgotPassword" method="post" class="theme-form">
                    <h4 class="text-center">Quên mật khẩu</h4>
                    <p class="text-center">Nhập email admin để reset mật khẩu</p>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success">
                            @ViewBag.Message
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-warning w-100">
                            Reset mật khẩu
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-area="Admin" asp-controller="Auth" asp-action="Login">
                            Quay lại đăng nhập
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
