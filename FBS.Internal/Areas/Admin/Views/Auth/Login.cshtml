@using FBS.Application.DataTranferObjects.Auth
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = "~/Areas/Admin/Views/Shared/_EmptyLayout.cshtml";
}

<div class="row m-0">
    <div class="col-12 p-0">
        <div class="login-card">
            <div>
                <div><a class="logo" asp-controller="Home" asp-action="Index"></a></div>
                <div class="login-main">
                    <form class="theme-form"
                          asp-area="Admin"
                          asp-controller="Auth"
                          asp-action="Login"
                          method="post"
                          novalidate>

                        <h4 class="text-center">Đăng nhập</h4>
                        <p class="text-center">Nhập tên tài khoản và mật khẩu để tiếp tục</p>

                       
                        <div class="alert alert-danger dark" asp-validation-summary="ModelOnly"></div>

                     
                        <div class="form-group">
                            <label asp-for="Username" class="col-form-label required">Tài khoản</label>
                            <input class="form-control" type="text" asp-for="Username" placeholder="Nhập tài khoản">
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                     
                        <div class="form-group">
                            <label asp-for="Password" class="col-form-label required">Mật khẩu</label>
                            <div class="form-input position-relative">
                                <input class="form-control"
                                       type="password"
                                       asp-for="Password"
                                       id="passwordInput"
                                       placeholder="*********">
                                <div class="show-hide" onclick="togglePassword()">
                                    <span id="toggleIcon" class="show"></span>
                                </div>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                       
                        <div class="form-group mb-0">
                            <div class="checkbox p-0">
                                <input id="checkbox1" type="checkbox" asp-for="RememberMe">
                                <label class="text-muted" for="checkbox1">Ghi nhớ đăng nhập</label>
                                <a asp-area="Admin" asp-controller="Auth" asp-action="ForgotPassword" class="float-end">
                                    Quên mật khẩu?
                                </a>
                            </div>

                          
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                            <div class="text-end mt-3">
                                <button class="btn btn-primary btn-block w-100" type="submit">Đăng nhập</button>
                            </div>
                        </div>

                        <p class="mt-4 mb-0 text-center">
                            Nếu bạn chưa có tài khoản?
                            <a asp-area="Admin" asp-controller="Auth" asp-action="Register">
                                Tạo tài khoản admin
                            </a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        const input = document.getElementById("passwordInput");
        const icon = document.getElementById("toggleIcon");
        if (!input) return;
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("show");
            icon.classList.add("hide");
        } else {
            input.type = "password";
            icon.classList.remove("hide");
            icon.classList.add("show");
        }
    }
</script>
