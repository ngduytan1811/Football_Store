@using FBS.API.Responses.Base
@using FBS.Application.DataTranferObjects.Users

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var users = (BaseTableResponse<UserDto>)ViewData["Users"];
}

<div class="col-sm-12">
    <div class="text-end mb-3">
        <a asp-action="Create" asp-controller="User" class="btn btn-primary">Thêm mới tài khoản</a>
    </div>
    <div class="card">
        <div class="card-header">
            <h4>Danh sách tài khoản</h4>
        </div>
        <div class="card-block row">
            <div class="col-sm-12 col-lg-12 col-xl-12">
                <div class="table-responsive theme-scrollbar px-4">
                    <table class="table table-hover table-lg">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Tên tài khoản</th>
                                <th scope="col">Số điện thoại</th>
                                <th scope="col">Email</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (users != null)
                            {
                                @foreach (var user in users.Items)
                                {
                                    <tr class="py-2">
                                        <th>@user.Index</th>
                                        <td>@(user.Username ?? "--")</td>
                                        <td>@(user.PhoneNumber ?? "--")</td>
                                        <td>@(user.Email ?? "--")</td>
                                        <td class="font-danger">@user.StatusName</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-action="Edit" asp-controller="User" asp-route-userId="@user.Id" class="btn btn-primary btn-sm text-white btn-icon">
                                                    <i class="fa fa-pencil"></i>
                                                </a>
                                                <form asp-action="Delete" asp-controller="User" asp-route-userId="@user.Id" method="post">
                                                    <button type="submit" class="btn btn-danger btn-sm text-white btn-icon">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

