@using FBS.Application.DataTranferObjects.Users

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@model UserSaveDto

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0">
                <h4>Cập nhật tài khoản</h4>
            </div>
            <form asp-action="Update" asp-route-userId="@Model.Id" asp-controller="User" method="post">

                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label required" asp-for="UserName">Tên tài khoản</label>
                                <input class="form-control" type="text" asp-for="UserName" placeholder="Nhập tên danh mục">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" asp-for="PhoneNumber">Số điện thoại</label>
                                <input class="form-select digits" asp-for="PhoneNumber" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" asp-for="Email">Email</label>
                                <input class="form-control" type="text" asp-for="Email" placeholder="Nhập tên danh mục">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" asp-for="IsActive">Trạng thái tài khoản</label>
                                <select class="form-select" asp-for="IsActive">
                                    <option value="true">Hoạt động</option>
                                    <option value="false">Bị khóa</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <button class="btn btn-primary" type="submit">Lưu</button>
                    <a class="btn btn-light" asp-action="Index" asp-controller="User">Quay lại </a>
                </div>
            </form>
        </div>
    </div>
</div>

