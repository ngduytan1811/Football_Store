@using FBS.Application.DataTranferObjects.Reports

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var chart7Days = ViewBag.Last7DaysRevenue
        as List<RevenueChartDto>
        ?? new List<RevenueChartDto>();

    var rangeChart = ViewBag.RangeChartData
        as List<RevenueChartDto>
        ?? new List<RevenueChartDto>();
}

<h2 class="fw-bold mb-4">Báo cáo doanh thu</h2>



<!-- ======================= THỐNG KÊ DOANH THU ======================= -->
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-primary text-white">
            <div class="fs-4 fw-bold">@ViewBag.TotalRevenue.ToString("N0") đ</div>
            <small>Tổng doanh thu</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-success text-white">
            <div class="fs-4 fw-bold">@ViewBag.TodayRevenue.ToString("N0") đ</div>
            <small>Doanh thu hôm nay</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-warning text-white">
            <div class="fs-4 fw-bold">@ViewBag.ThisMonthRevenue.ToString("N0") đ</div>
            <small>Doanh thu tháng này</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-info text-white">
            <div class="fs-4 fw-bold">@ViewBag.TotalOrders</div>
            <small>Tổng đơn hàng</small>
        </div>
    </div>

</div>

<!-- ======================= TRẠNG THÁI ĐƠN HÀNG ======================= -->
<div class="row g-3 mb-5">

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-secondary text-white">
            <div class="fs-4 fw-bold">@ViewBag.ProcessingOrders</div>
            <small>Đang xử lý</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm" style="background:#e6fffb;">
            <div class="fs-4 fw-bold">@ViewBag.ShippingOrders</div>
            <small>Đang giao</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm" style="background:#ffe7eb;">
            <div class="fs-4 fw-bold">@ViewBag.CompletedOrders</div>
            <small>Hoàn thành</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm" style="background:#fff1f0;">
            <div class="fs-4 fw-bold">@ViewBag.CanceledOrders</div>
            <small>Đã hủy</small>
        </div>
    </div>

</div>

<hr />

<!-- ======================= LỌC DOANH THU THEO NGÀY ======================= -->
<form method="get" asp-action="Index" class="d-flex gap-2 mb-4">

    <input type="date"
           name="fromDate"
           value="@ViewBag.FromDate"
           class="form-control"
           style="width: 200px;" />

    <input type="date"
           name="toDate"
           value="@ViewBag.ToDate"
           class="form-control"
           style="width: 200px;" />

    <button class="btn btn-primary">Xem doanh thu</button>
</form>

@if (ViewBag.RevenueInRange != null)
{
    @if (ViewBag.DateError == null && ViewBag.RevenueInRange != null)
    {
        <h3>
            Doanh thu từ @ViewBag.FromDate → @ViewBag.ToDate :
            <span class="text-success fw-bold">
                @string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:N0}", ViewBag.RevenueInRange) đ
            </span>
        </h3>
    }



    <canvas id="rangeChart" height="80"></canvas>
}
@if (ViewBag.DateError != null)
{
    <div class="text-danger fw-bold">
        @ViewBag.DateError
    </div>
}


<hr />

<!-- ======================= BIỂU ĐỒ DOANH THU 7 NGÀY ======================= -->
<h4 class="fw-bold mb-3">Doanh thu 7 ngày gần nhất</h4>

<canvas id="chart7days" height="80"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    /* --- BIỂU ĐỒ 7 NGÀY: LINE + GRADIENT --- */
    const ctx = document.getElementById('chart7days').getContext('2d');

    // Gradient màu đẹp
    const gradient = ctx.createLinearGradient(0, 0, 0, 300);
    gradient.addColorStop(0, 'rgba(0, 123, 255, 0.5)');
    gradient.addColorStop(1, 'rgba(0, 123, 255, 0)');

    // Dữ liệu 7 ngày
    const labels7 = [@string.Join(",", chart7Days.Select(x => $"\"{x.Date}\""))];
    const data7 = [@string.Join(",", chart7Days.Select(x => x.Revenue))];

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels7,
            datasets: [{
                label: "Doanh thu",
                data: data7,
                fill: true,
                backgroundColor: gradient,
                borderColor: '#007bff',
                borderWidth: 3,
                tension: 0.4,
                pointRadius: 5,
                pointBackgroundColor: '#007bff',
                pointBorderColor: '#ffffff',
                pointHoverRadius: 8,
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: "#000",
                    titleColor: "#fff",
                    bodyColor: "#fff"
                }
            },
            scales: {
                y: { beginAtZero: true },
                x: { grid: { display: false } }
            }
        }
    });

    /* --- BIỂU ĐỒ DOANH THU THEO KHOẢNG NGÀY --- */
    @if (rangeChart.Any())
    {
        <text>
            const labelsR = [@string.Join(",", rangeChart.Select(x => $"\"{x.Date}\""))];
            const dataR = [@string.Join(",", rangeChart.Select(x => x.Revenue))];

            new Chart(document.getElementById('rangeChart'), {
                type: 'bar',
                data: {
                    labels: labelsR,
                    datasets: [{
                        label: "Doanh thu",
                        data: dataR,
                        backgroundColor: '#4e73df',
                        borderRadius: 6
                    }]
                }
            });
        </text>
    }

</script>

<hr />

<!-- ======================= TOP 5 SẢN PHẨM ======================= -->
<h4 class="fw-bold mb-3">Top 5 sản phẩm bán chạy</h4>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng bán</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.TopProducts)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.TotalQuantity</td>
            </tr>
        }
    </tbody>
</table>
