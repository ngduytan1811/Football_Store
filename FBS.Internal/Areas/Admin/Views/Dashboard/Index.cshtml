@using FBS.Application.DataTranferObjects.Reports

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var chart7Days = ViewBag.Last7DaysRevenue as List<RevenueChartDto> ?? new();
    var rangeChart = ViewBag.RangeChartData as List<RevenueChartDto> ?? new();
    var topProducts = ViewBag.TopProducts as List<TopProductDto> ?? new();
}

<h2 class="fw-bold mb-4">Báo cáo doanh thu</h2>


<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-primary text-white">
            <div class="fs-4 fw-bold">
                @(((decimal?)ViewBag.TotalRevenue ?? 0).ToString("N0")) đ
            </div>
            <small>Tổng doanh thu</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-success text-white">
            <div class="fs-4 fw-bold">
                @(((decimal?)ViewBag.TodayRevenue ?? 0).ToString("N0")) đ
            </div>
            <small>Doanh thu hôm nay</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-warning text-white">
            <div class="fs-4 fw-bold">
                @(((decimal?)ViewBag.ThisMonthRevenue ?? 0).ToString("N0")) đ
            </div>
            <small>Doanh thu tháng này</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-info text-white">
            <div class="fs-4 fw-bold">@((int?)ViewBag.TotalOrders ?? 0)</div>
            <small>Tổng đơn hàng</small>
        </div>
    </div>

</div>


<div class="row g-3 mb-5">

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm bg-secondary text-white">
            <div class="fs-4 fw-bold">@((int?)ViewBag.ProcessingOrders ?? 0)</div>
            <small>Giao thành công</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm" style="background:#e6fffb;">
            <div class="fs-4 fw-bold">@((int?)ViewBag.ShippingOrders ?? 0)</div>
            <small>Đang giao</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm" style="background:#ffe7eb;">
            <div class="fs-4 fw-bold">@((int?)ViewBag.CompletedOrders ?? 0)</div>
            <small>Đang xử lý</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="p-3 rounded shadow-sm" style="background:#fff1f0;">
            <div class="fs-4 fw-bold">@((int?)ViewBag.CanceledOrders ?? 0)</div>
            <small>Đã hủy</small>
        </div>
    </div>

</div>

<hr />


<form method="get" asp-action="Index" class="d-flex gap-2 mb-4">
    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" style="width:200px;" />
    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" style="width:200px;" />
    <button class="btn btn-primary">Xem doanh thu</button>
</form>

@if (ViewBag.DateError != null)
{
    <div class="text-danger fw-bold mb-3">@ViewBag.DateError</div>
}
else if (ViewBag.RevenueInRange != null)
{
    <h4>
        Doanh thu từ @ViewBag.FromDate → @ViewBag.ToDate :
        <span class="text-success fw-bold">
            @string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:N0}", ViewBag.RevenueInRange) đ
        </span>
    </h4>

    @if (rangeChart.Any())
    {
        <canvas id="rangeChart" height="80"></canvas>
    }
}

<hr />


<h4 class="fw-bold mb-3">Doanh thu 7 ngày gần nhất</h4>

@if (chart7Days.Any())
{
    <canvas id="chart7days" height="80"></canvas>
}
else
{
    <div class="text-muted">Chưa có dữ liệu 7 ngày</div>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    @if (chart7Days.Any())
    {
        <text>
            const ctx = document.getElementById('chart7days').getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(0,123,255,0.5)');
            gradient.addColorStop(1, 'rgba(0,123,255,0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [@string.Join(",", chart7Days.Select(x => $"\"{x.Date}\""))],
                    datasets: [{
                        data: [@string.Join(",", chart7Days.Select(x => x.Revenue))],
                        fill: true,
                        backgroundColor: gradient,
                        borderColor: '#007bff',
                        borderWidth: 3,
                        tension: 0.4,
                        pointRadius: 5
                    }]
                },
                options: { plugins: { legend: { display: false } } }
            });
        </text>
    }

    @if (rangeChart.Any())
    {
        <text>
            new Chart(document.getElementById('rangeChart'), {
                type: 'bar',
                data: {
                    labels: [@string.Join(",", rangeChart.Select(x => $"\"{x.Date}\""))],
                    datasets: [{
                        data: [@string.Join(",", rangeChart.Select(x => x.Revenue))],
                        backgroundColor: '#4e73df',
                        borderRadius: 6
                    }]
                }
            });
        </text>
    }
</script>

<hr />


<h4 class="fw-bold mb-3">Top 5 sản phẩm bán chạy</h4>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng bán</th>
        </tr>
    </thead>
    <tbody>
        @if (topProducts.Any())
        {
            foreach (var item in topProducts)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.TotalQuantity</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center text-muted">Chưa có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>
