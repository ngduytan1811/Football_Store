@model FBS.Application.DataTranferObjects.Blog.BlogSaveDto

@{
    ViewData["Title"] = "Thêm bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6">
                <h3>Thêm bài viết</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Dashboard"><i data-feather="home"></i></a>
                    </li>
                    <li class="breadcrumb-item active">Thêm bài viết</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid add-product">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row">

            <!-- LEFT -->
            <div class="col-xl-8">
                <div class="card shadow-sm">
                    <div class="card-body">

                        <!-- Tiêu đề -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Tiêu đề</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="Nhập tiêu đề bài viết" />
                        </div>

                        <!-- Tác giả -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Tác giả</label>
                            <input asp-for="Author" class="form-control form-control-lg" placeholder="Tên tác giả" />
                        </div>

                        <!-- Nội dung đoạn 1 -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Nội dung đoạn 1</label>
                            <textarea asp-for="ContentPart1"
                                      rows="6"
                                      class="form-control"></textarea>
                        </div>

                        <!-- Nội dung đoạn 2 -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Nội dung đoạn 2</label>
                            <textarea asp-for="ContentPart2"
                                      rows="6"
                                      class="form-control"></textarea>
                        </div>

                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-xl-4">
                <div class="card shadow-sm">
                    <div class="card-body">

                        <!-- Thumbnail -->
                        <h5 class="fw-bold">Ảnh thumbnail</h5>
                        <div class="mb-4">
                            <input asp-for="ThumbnailFile"
                                   class="form-control"
                                   type="file"
                                   accept="image/*"
                                   onchange="previewThumbnail(event)" />

                            <img id="thumbnailPreview"
                                 src=""
                                 style="width:100%;margin-top:10px;display:none;border-radius:10px;object-fit:cover" />
                        </div>

                        <!-- Ảnh phụ -->
                        <h5 class="fw-bold">Ảnh phụ (nhiều hình)</h5>
                        <div class="mb-4">
                            <input id="SubImageFiles"
                                   name="SubImageFiles"
                                   type="file"
                                   multiple
                                   accept="image/*"
                                   class="form-control"
                                   onchange="previewSubImages(event)" />
                        </div>

                        <!-- PREVIEW ẢNH PHỤ -->
                        <div id="subImagePreview" class="mt-3"></div>

                        <div class="text-end mt-4">
                            <button type="submit"
                                    class="btn btn-primary px-4 py-2 me-3">
                                Lưu bài viết
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary px-4 py-2">
                                Hủy
                            </a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        /* ============ PREVIEW THUMBNAIL ============ */
        function previewThumbnail(event) {
            const reader = new FileReader();
            reader.onload = function () {
                const img = document.getElementById('thumbnailPreview');
                img.src = reader.result;
                img.style.display = 'block';
            };
            reader.readAsDataURL(event.target.files[0]);
        }

        /* ============ PREVIEW NHIỀU ẢNH PHỤ ============ */
        let selectedSubImages = [];

        function previewSubImages(event) {
            const files = Array.from(event.target.files);
            selectedSubImages.push(...files);
            updatePreview();
            updateInputFiles();
        }

                  function updatePreview() {
            const preview = document.getElementById('subImagePreview');
            preview.innerHTML = "";

            selectedSubImages.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = e => {

                    const div = document.createElement("div");
                    div.classList.add("mb-3");

                    div.innerHTML = `
                        <div class="position-relative">
                            <img src="${e.target.result}"
                                 style="width:100%; height:150px; object-fit:cover; border-radius:10px;" />

                            <button type="button"
                                    class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2"
                                    onclick="removeSubImage(${index})"
                                    style="border-radius:50px;">✕</button>
                        </div>
                    `;

                    preview.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        }



        function removeSubImage(index) {
            selectedSubImages.splice(index, 1);
            updatePreview();
            updateInputFiles();
        }

        function updateInputFiles() {
            const dataTransfer = new DataTransfer();
            selectedSubImages.forEach(f => dataTransfer.items.add(f));
            document.getElementById("SubImageFiles").files = dataTransfer.files;
        }
    </script>
}
