@model FBS.Application.DataTranferObjects.Blog.BlogSaveDto

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid add-product">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Thumbnail" />

        <div class="row g-4">

       
            <div class="col-xl-8">
                <div class="card shadow-sm">
                    <div class="card-body p-4">

                        <div class="mb-4">
                            <label class="fw-bold">Tiêu đề</label>
                            <input asp-for="Title" class="form-control form-control-lg" />
                        </div>

                        <div class="mb-4">
                            <label class="fw-bold">Tác giả</label>
                            <input asp-for="Author" class="form-control form-control-lg" />
                        </div>

                        @{
                            string[] parts = (Model.Content ?? "").Split("<!--IMG-BLOCK-->");
                            string p1 = parts.Length > 0 ? parts[0] : "";
                            string p2 = parts.Length > 1 ? parts[1] : "";
                        }

                        <div class="mb-4">
                            <label class="fw-bold">Nội dung đoạn 1</label>
                            <textarea name="ContentPart1" rows="6" class="form-control">@p1</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="fw-bold">Nội dung đoạn 2</label>
                            <textarea name="ContentPart2" rows="6" class="form-control">@p2</textarea>
                        </div>

                    </div>
                </div>
            </div>

      
            <div class="col-xl-4">
                <div class="card shadow-sm">
                    <div class="card-body p-4">

                        <h5 class="fw-bold">Ảnh thumbnail</h5>

                        @if (!string.IsNullOrEmpty(Model.Thumbnail))
                        {
                            <img src="~/@Model.Thumbnail"
                                 id="oldImg"
                                 style="width:100%; height:220px; object-fit:cover; border-radius:10px; margin-bottom:10px;" />
                        }

                        <input asp-for="ThumbnailFile" type="file" class="form-control mb-3"
                               accept="image/*" onchange="previewThumbnail(event)" />

                        <img id="previewImg"
                             style="width:100%; height:220px; object-fit:cover; border-radius:10px; display:none;" />

                     
                        <h5 class="fw-bold mt-3">Ảnh phụ (cũ + mới)</h5>

                        <div id="imagesContainer" class="row mt-2">

                            @foreach (var img in Model.SubImages)
                            {
                                <div class="col-4 mb-3 position-relative image-item"
                                     data-type="old" data-img="@img">

                                  
                                    <input type="hidden" name="OldSubImages" value="@img" />

                                    <img src="/@img"
                                         style="width:100%; height:120px; object-fit:cover; border-radius:10px;" />

                                    <button type="button"
                                            class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1"
                                            onclick="removeImage(this)"
                                            style="border-radius:50px;">
                                        ✕
                                    </button>
                                </div>
                            }

                        </div>

                      
                        <h5 class="fw-bold mt-4">Thêm ảnh phụ mới</h5>

                        <input id="SubImageFiles"
                               name="SubImageFiles"
                               type="file"
                               multiple
                               accept="image/*"
                               class="form-control mb-3"
                               onchange="previewNewImages(event)" />

                        <button type="submit" class="btn btn-primary px-4 w-100">
                            Lưu thay đổi
                        </button>

                    </div>
                </div>
            </div>

        </div>

    </form>
</div>

@section Scripts {
    <script>

      
        function previewThumbnail(event) {
            const reader = new FileReader();
            reader.onload = () => {
                document.getElementById('previewImg').src = reader.result;
                document.getElementById('previewImg').style.display = "block";

                const oldImg = document.getElementById('oldImg');
                if (oldImg) oldImg.style.display = "none";
            };
            reader.readAsDataURL(event.target.files[0]);
        }


       
        let newImages = [];

        function previewNewImages(event) {
            const files = Array.from(event.target.files);

            files.forEach(file => {
                newImages.push(file);

                const reader = new FileReader();
                reader.onload = e => {

                    const div = document.createElement("div");
                    div.classList.add("col-4", "mb-3", "position-relative", "image-item");
                    div.dataset.type = "new";

                    div.innerHTML = `
                        <img src="${e.target.result}"
                             style="width:100%; height:120px; object-fit:cover; border-radius:10px;" />
                        <button type="button"
                                class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1"
                                onclick="removeImage(this)"
                                style="border-radius:50px;">✕</button>
                    `;

                    document.getElementById("imagesContainer").appendChild(div);
                };

                reader.readAsDataURL(file);
            });

            updateInputFiles();
        }


     
        function removeImage(btn) {

            const item = btn.closest(".image-item");
            const type = item.dataset.type;

            if (type === "old") {
               
                const hidden = item.querySelector("input[name='OldSubImages']");
                if (hidden) hidden.remove();
            }

            if (type === "new") {
                const newItems = Array.from(document.querySelectorAll(".image-item[data-type='new']"));
                const index = newItems.indexOf(item);

                if (index >= 0) {
                    newImages.splice(index, 1);
                }
                updateInputFiles();
            }

            item.remove();
        }


      
        function updateInputFiles() {
            const dt = new DataTransfer();
            newImages.forEach(f => dt.items.add(f));
            document.getElementById("SubImageFiles").files = dt.files;
        }

    </script>
}
