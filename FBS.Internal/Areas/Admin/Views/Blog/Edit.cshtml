@model FBS.Application.DataTranferObjects.Blog.BlogSaveDto

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var blog = Model; // dữ liệu load từ controller
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6">
                <h3>Chỉnh sửa bài viết</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard"><i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Edit Blog</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid add-product">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="row">

            <!-- LEFT -->
            <div class="col-xl-8">
                <div class="card">
                    <div class="card-body">

                        <!-- Title -->
                        <div class="mb-3">
                            <label class="form-label">Tiêu đề</label>
                            <input asp-for="Title" class="form-control" />
                        </div>

                        <!-- Author -->
                        <div class="mb-3">
                            <label class="form-label">Tác giả</label>
                            <input asp-for="Author" class="form-control" />
                        </div>

                        <!-- Content -->
                        <div class="mb-3">
                            <label class="form-label">Nội dung</label>
                            <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                        </div>

                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-xl-4">
                <div class="card">
                    <div class="card-body">

                        <!-- Thumbnail -->
                        <h5>Ảnh thumbnail</h5>

                        <!-- Ảnh cũ -->
                        @if (!string.IsNullOrEmpty(blog.Thumbnail))
                        {
                            <img src="~/@blog.Thumbnail" id="oldImg"
                                 style="width:100%;border-radius:8px;margin-bottom:10px" />
                        }

                        <!-- Chọn ảnh mới -->
                        <div class="mb-3">
                            <input asp-for="ThumbnailFile" class="form-control" type="file" accept="image/*" onchange="previewImage(event)" />

                            <!-- Preview ảnh mới -->
                            <img id="previewImg"
                                 src=""
                                 style="width:100%;margin-top:10px;display:none;border-radius:8px;object-fit:cover" />
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary me-3">Lưu thay đổi</button>
                            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<script>
    feather.replace();

    function previewImage(event) {
        const reader = new FileReader();

        reader.onload = function () {
            const newImg = document.getElementById('previewImg');
            newImg.src = reader.result;
            newImg.style.display = 'block';

            // Ẩn ảnh cũ
            const oldImg = document.getElementById('oldImg');
            if (oldImg) oldImg.style.display = 'none';
        };

        reader.readAsDataURL(event.target.files[0]);
    }
</script>
