@using FBS.API.Responses.Base
@using FBS.Application.DataTranferObjects.Blog

@{
    ViewData["Title"] = "Danh sách bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var blogs = (BaseTableResponse<BlogDto>)ViewData["Blogs"];
}

<div class="container-fluid basic_table">
    <div class="text-end mb-3">
        <a asp-action="Create" asp-controller="Blog" class="btn btn-primary">Thêm bài viết</a>
    </div>

    <div class="card px-4">
        <div class="table-responsive py-4">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ảnh</th>
                        <th>Tiêu đề</th>
                        <th>Tác giả</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 0;
                    }
                    @foreach (var blog in blogs.Items)
                    {
                        <tr>
                            <td>@(++index)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(blog.Thumbnail))
                                {
                                    <img src="@Url.Content("~/" + blog.Thumbnail)" style="width:60px;height:60px;object-fit:cover" />
                                }
                            </td>
                            <td>@blog.Title</td>
                            <td>@blog.Author</td>
                            <td>@blog.CreatedAt?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@blog.Id" class="text-primary me-2">
                                    <i data-feather="edit-2"></i>
                                </a>

                                <form asp-action="Delete" asp-route-id="@blog.Id" method="post" style="display:inline">
                                    <button type="submit"
                                            class="btn btn-link text-danger p-0"
                                            onclick="return confirm('Xóa bài viết này?');">
                                        <i data-feather="trash-2"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
