@model FBS.Internal.Areas.Admin.Models.AdminProfileViewModel
@{
    ViewData["Title"] = "Thông tin Admin";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Hồ sơ quản trị viên</h5>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Tên đăng nhập</div>
                <div class="col-md-8">@Model.UserName</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Email</div>
                <div class="col-md-8">@Model.Email</div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">Quyền</div>
                <div class="col-md-8">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge bg-success me-1">@role</span>
                    }
                </div>
            </div>
            <a asp-action="ChangePassword" class="btn btn-warning mt-3">
                Đổi mật khẩu
            </a>
        </div>
    </div>
</div>
