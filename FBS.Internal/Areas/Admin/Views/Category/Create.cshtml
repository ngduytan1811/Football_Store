@using FBS.Application.DataTranferObjects.Categories
@model CategorySaveDto

@{
    ViewData["Title"] = "Thêm mới danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var categoryDropdown = (List<CategoryDto>)ViewData["Categories"];

}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">➕ Thêm mới danh mục</h5>
            </div>

            <form asp-action="Create"
                  asp-controller="Category"
                  method="post"
                  class="p-4">

                
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold">
                        Tên danh mục <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name"
                           class="form-control form-control-lg"
                           placeholder="Nhập tên danh mục..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

              
                <div class="mb-4">
                    <label asp-for="ParentId" class="form-label fw-bold">
                        Danh mục cha
                    </label>

                    <select asp-for="ParentId"
                            class="form-select form-select-lg"
                            asp-items="@(new SelectList(categoryDropdown, "Id", "Name"))">
                        <option value="">-- Chọn danh mục cha (tùy chọn) --</option>
                    </select>

                    <span asp-validation-for="ParentId" class="text-danger"></span>
                </div>

          
                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập mô tả ngắn..."></textarea>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index"
                       asp-controller="Category"
                       class="btn btn-light px-4">
                         Quay lại
                    </a>

                    <button type="submit" class="btn btn-primary px-5">
                         Lưu danh mục
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
