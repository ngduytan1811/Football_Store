@using FBS.Application.DataTranferObjects.Categories
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var categoryDropdown = (List<CategoryDto>)ViewData["Categogries"];
}
@model CategorySaveDto

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header pb-0">
                <h4>Cập nhật danh mục</h4>
            </div>
            <form class="form theme-form" asp-action="Update" asp-route-id="@Model.Id" enctype="multipart/form-data" asp-controller="Category" method="post" novalidate>
                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" asp-for="Name">Tên danh mục <span class="text-danger">*</span></label>
                                <input class="form-control" type="text" asp-for="Name" placeholder="Nhập tên danh mục">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" asp-for="ParentId">Danh mục cha</label>
                                <select class="form-select digits" asp-for="ParentId">
                                    @if (categoryDropdown != null)
                                    {
                                        @foreach (var item in categoryDropdown)
                                        {
                                            <option selected="@(Model.ParentId == item.Id)" value="@item.Id">@item.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" asp-for="Description">Tóm tắt</label>
                                <input class="form-control" type="text" asp-for="Description" placeholder="Nhập nội dung">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label class="form-label" asp-for="Logo">Hình ảnh</label>
                                <input class="form-control" type="file" asp-for="Logo" placeholder="Nhập tên danh mục">
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-footer text-end">
                    <button class="btn btn-primary" type="submit">Lưu</button>
                    <a class="btn btn-light" asp-action="Index" asp-controller="Category">Quay lại </a>
                </div>
            </form>
        </div>
    </div>
</div>

