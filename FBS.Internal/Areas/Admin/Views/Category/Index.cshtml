@using FBS.API.Responses.Base
@using FBS.Application.DataTranferObjects.Categories
@using FBS.Shared.Enums

@{
    ViewData["Title"] = "Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var categories = (BaseTableResponse<CategoryDto>)ViewData["Categories"];
}

<div class="container-fluid basic_table">
    <div class="row">
        <div class="text-end mb-3">
            <a asp-action="Create" asp-controller="Category" class="btn btn-primary">Thêm mới danh mục</a>
        </div>
        <div class="card">
            <div class="card-header">
                <h4>Danh sách danh mục</h4>
            </div>
            <div class="card-block row">
                <div class="col-sm-12 col-lg-12 col-xl-12">
                    <div class="table-responsive theme-scrollbar px-4 py-4">
                        <table class="table table-hover table-lg">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Tên Danh mục</th>
                                    <th scope="col">Danh mục cha</th>
                                    <th scope="col">Trạng thái</th>
                                    <th scope="col">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in categories.Items)
                                {
                                    <tr>
                                        <td class="p-2">@category.Index</td>
                                        <td class="py-2">@category.Name</td>
                                        <td class="py-2">@(category.ParentName ?? "--")</td>
                                        <td class="@(category.Status == StatusEnum.Inactive ? "font-danger" : "font-primary") py-2">@category.StatusName</td>
                                        <td class="py-2">
                                            <a asp-action="Edit"
                                               asp-controller="Category"
                                               asp-route-id="@category.Id"
                                               class="btn btn-link p-0 m-1">
                                                <i data-feather="edit-2"></i>
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-controller="Category"
                                                  asp-route-id="@category.Id"
                                                  method="post"
                                                  class="d-inline">
                                                <button type="submit" class="btn btn-link text-danger p-0 m-1">
                                                    <i data-feather="trash-2"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

