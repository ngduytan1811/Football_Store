@using FBS.Application.DataTranferObjects.Categories
@using FBS.Application.DataTranferObjects.Products
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var categoryDropdown = (List<CategoryDto>)ViewData["Categogries"];
}
@model ProductSaveDto

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6">
                <h3>Cập nhật sản phẩm</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard"><i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Cập nhật sản phẩm</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid add-product">
    <form asp-action="Update" asp-route-id="@Model.Id" asp-controller="Product" method="post">
        <div class="row">
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body">
                        <div class="product-info">
                            <h5>Thông tin</h5>
                            <div class="product-group">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="mb-3">
                                            <label class="form-label">Tên sản phẩm</label>
                                            <input class="form-control" asp-for="Name" placeholder="Tên sản phẩm" type="text"><span class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="mb-3">
                                            <label class="form-label">Tóm tắt</label>
                                            <input class="form-control" asp-for="Description" placeholder="Nội dung" type="text"><span class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <h5 class="mt-4">Danh mục</h5>
                            <div class="product-group">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="mb-3">
                                            <label class="form-label">Danh mục</label>
                                            <select asp-for="CategoryId" class="form-select">
                                                <option selected hidden value="">Chọn..</option>
                                                @foreach (var cate in categoryDropdown)
                                                {
                                                    <option value="@cate.Id">@cate.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label">Thương hiệu</label>
                                            <select class="form-select">
                                                <option>Chọn..</option>
                                                <option>Levi's</option>
                                                <option>Hudson</option>
                                                <option>Denizen</option>
                                                <option>Spykar</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label">Màu</label>
                                            <select asp-for="Color" class="form-select">
                                                <option hidden selected>Chọn..</option>
                                                <option value="Đen">Đen</option>
                                                <option value="Đỏ">Đỏ</option>
                                                <option value="Xanh">Xanh</option>
                                                <option value="Trắng">Trắng</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body ">
                        <div class="product-info">
                            <h5>Ảnh sản phẩm</h5>
                            <div class="mb-3">
                                <input class="form-control" type="file">
                            </div>
                            <h5 class="mt-4">Kích thước</h5>
                            <div class="product-group">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label">Kích thước</label>
                                            <select asp-for="Size" class="form-select">
                                                <option value="39">39 </option>
                                                <option value="40">40 </option>
                                                <option value="41">41 </option>
                                                <option value="42">42 </option>
                                                <option value="43">43</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label">Giá</label>
                                            <input asp-for="Price" class="form-control" type="number">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="row">
                                <div class="col-sm-12 text-end"><button type="submit" class="btn btn-primary me-3">Cập nhật </button><a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Hủy</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

</div>

