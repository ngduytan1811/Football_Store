@using FBS.Application.DataTranferObjects.Categories
@using FBS.Application.DataTranferObjects.Products
@using FBS.Shared.Constants
@model ProductSaveDto

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var categoryDropdown = (List<CategoryDto>)ViewData["Categories"];
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6">
                <h3>Cập nhật sản phẩm</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard"><i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid add-product">
    <form asp-action="Update" asp-controller="Product" method="post" enctype="multipart/form-data" asp-route-id="@Model.Id">
        <div class="row">

            
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body">
                        <h5>Thông tin sản phẩm</h5>

                     
                        <div class="mb-3">
                            <label class="form-label">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <!-- Tóm tắt -->
                        <div class="mb-3">
                            <label class="form-label">Tóm tắt</label>
                            <input asp-for="Description" class="form-control" />
                        </div>

                      
                        <div class="mb-3">
                            <label class="form-label">Danh mục</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option hidden selected>Chọn...</option>
                                @foreach (var cate in categoryDropdown)
                                {
                                    <option value="@cate.Id" selected="@(Model.CategoryId == cate.Id)">
                                        @cate.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <!-- Brand -->
                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Thương hiệu</label>
                                <select asp-for="Brand" class="form-select">
                                    <option hidden selected>Chọn...</option>
                                    @foreach (var brand in GlobalConstants.Brands)
                                    {
                                        <option value="@brand" selected="@(brand == Model.Brand)">@brand</option>
                                    }
                                </select>
                            </div>

                       
                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Màu</label>
                                <select asp-for="Color" class="form-select">
                                    <option hidden selected>Chọn...</option>
                                    @foreach (var color in GlobalConstants.Color)
                                    {
                                        <option value="@color" selected="@(color == Model.Color)">@color</option>
                                    }
                                </select>
                            </div>
                        </div>

                       
                        <div class="mb-3">
                            <label class="form-label">Thông tin chi tiết (phần 1)</label>
                            <textarea asp-for="DetailPart1" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Thông tin chi tiết (phần 2)</label>
                            <textarea asp-for="DetailPart2" class="form-control" rows="4"></textarea>
                        </div>

                     
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Giá (đ)</label>
                                <input asp-for="Price" class="form-control" type="text"
                                       value="@(Model.Price.HasValue ? Model.Price.Value.ToString("#,##0") : "")"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'');" />
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Giảm giá (%)</label>
                                <input asp-for="Discount" class="form-control" type="number" step="1" min="0" max="100" />
                            </div>
                        </div>

                       
                        <div class="mb-3">
                            <label class="form-label">Kích thước</label>
                            <div class="form-group">
                                @foreach (var size in new[] { "39", "40", "41", "42", "43", "S", "M", "L", "XL", "2XL" })
                                {
                                    var isChecked = Model.Sizes != null && Model.Sizes.Contains(size);
                                    <label class="form-check form-check-inline">
                                        <input type="checkbox" name="Sizes" value="@size" class="form-check-input" @(isChecked ? "checked" : "") />
                                        <span class="form-check-label">@size</span>
                                    </label>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body">
                        <h5>Hình ảnh sản phẩm</h5>

                        <label class="form-label fw-bold">Ảnh chính</label>
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <div class="mb-2">
                                <img src="@Url.Content("~/theme/client/img/product/" + Model.Image)"
                                     style="width:150px;height:150px;object-fit:cover;border-radius:8px" />
                            </div>
                        }
                        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control"
                               onchange="previewMainImage(event)" />
                        <input type="hidden" asp-for="Image" />
                        <div id="mainImagePreview" class="mt-2"></div>

                        <hr />

                       
                        <label class="form-label fw-bold">Ảnh phụ</label>
                        @for (var i = 0; i < 3; i++)
                        {
                            var oldImage = Model.SubImages != null && Model.SubImages.Count > i ? Model.SubImages[i] : null;
                            <div class="mb-3">
                                <label class="form-label">Ảnh phụ @(i + 1)</label>
                                @if (oldImage != null)
                                {
                                    <img src="@Url.Content("~/theme/client/img/product/" + oldImage)"
                                         style="width:120px;height:120px;object-fit:cover;border-radius:8px;margin-bottom:10px" />
                                }
                                <input type="file" name="SubImageFiles" accept="image/*" onchange="previewEditSub(@i, event)" class="form-control" />
                                <input type="hidden" name="OldSubImages" value="@oldImage" />
                                <div id="previewEditSub@(i)" class="mt-2"></div>
                            </div>
                        }

                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-primary me-3">Cập nhật</button>
                            <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Hủy</a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<script>
    function previewMainImage(event) {
        const container = document.getElementById("mainImagePreview");
        container.innerHTML = "";
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => {
            const img = document.createElement("img");
            img.src = e.target.result;
            img.style.width = "150px";
            img.style.height = "150px";
            img.style.objectFit = "cover";
            img.style.borderRadius = "8px";
            container.appendChild(img);
        };
        reader.readAsDataURL(file);
    }

    function previewEditSub(index, event) {
        const div = document.getElementById("previewEditSub" + index);
        div.innerHTML = "";
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => {
            div.innerHTML = `<img src="${e.target.result}" style="width:120px;height:120px;border-radius:6px;object-fit:cover"/>`;
        };
        reader.readAsDataURL(file);
    }
</script>
