@using FBS.Application.DataTranferObjects.Categories
@using FBS.Application.DataTranferObjects.Products
@using FBS.Shared.Constants
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var categoryDropdown = (List<CategoryDto>)ViewData["Categories"];
}
@model FBS.Application.DataTranferObjects.Products.ProductSaveDto


<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6">
                <h3>Cập nhật sản phẩm</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard"><i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Cập nhật sản phẩm</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid add-product">
    <form asp-action="Update" asp-route-id="@Model.Id" asp-controller="Product" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body">
                        <div class="product-info">
                            <h5>Thông tin</h5>
                            <div class="product-group">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="mb-3">
                                            <label class="form-label">Tên sản phẩm</label>
                                            <input class="form-control" asp-for="Name" placeholder="Tên sản phẩm" type="text"><span class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="mb-3">
                                            <label class="form-label">Tóm tắt</label>
                                            <input class="form-control" asp-for="Description" placeholder="Nội dung" type="text"><span class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <h5 class="mt-4">Danh mục</h5>
                            <div class="product-group">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="mb-3">
                                            <label class="form-label">Danh mục</label>
                                            <select asp-for="CategoryId" class="form-select">
                                                <option selected hidden value="">Chọn..</option>

                                                @foreach (var cate in categoryDropdown)
                                                {
                                                    <option value="@cate.Id" selected="@(Model.CategoryId == cate.Id)">@cate.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label">Thương hiệu</label>
                                            <select asp-for="Brand" class="form-select">
                                                <option  hidden value="">Chọn..</option>
                                                @foreach (var brand in GlobalConstants.Brands)
                                                {
                                                    <option value="@brand" selected="@(Model.Brand == brand)">@brand</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label">Màu</label>
                                            <select asp-for="Color" class="form-select">
                                                <option  hidden value="">Chọn..</option>
                                                @foreach (var color in GlobalConstants.Color)
                                                {
                                                    <option value="@color" selected="@(Model.Color == color)">@color</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body ">
                        <div class="product-info">
                            <h5>Ảnh sản phẩm</h5>

                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="/theme/client/img/product/@Model.Image"
                                     style="width:150px;height:150px;object-fit:cover;border-radius:8px" />
                            }

                            <input class="form-control" asp-for="ImageFile" type="file" />
                            <input type="hidden" asp-for="Image" />



                            <h5 class="mt-4">Kích thước</h5>
                            <div class="product-group">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <label class="form-label">Kích thước</label>
                                        <div class="form-group">

                                            @foreach (var size in new[] { "39", "40", "41", "42", "43", "S", "M", "L", "XL", "2XL" })
                                            {
                                                var isChecked = Model.Sizes != null && Model.Sizes.Contains(size);

                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           name="Sizes[]"
                                                           value="@size"
                                                           id="size_@size"
                                                    @(isChecked ? "checked" : "") />

                                                    <label class="form-check-label" for="size_@size">@size</label>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="mb-3">
                                            <label class="form-label">Giá</label>
                                            <input asp-for="Price" class="form-control" type="number">
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="mt-4">
                            <div class="row">
                                <div class="col-sm-12 text-end"><button type="submit" class="btn btn-primary me-3">Cập nhật </button><a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Hủy</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

</div>

