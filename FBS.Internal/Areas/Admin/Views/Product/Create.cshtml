@using FBS.Application.DataTranferObjects.Categories
@using FBS.Application.DataTranferObjects.Products
@model ProductSaveDto

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var categoryDropdown = (List<CategoryDto>)ViewData["Categories"];
}

<div class="container-fluid add-product">

    <form asp-action="Create" asp-controller="Product" method="post" enctype="multipart/form-data">

        <div class="row">

           
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body">

                        <h5>Thông tin sản phẩm</h5>

                        <div class="mb-3">
                            <label class="form-label">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tóm tắt</label>
                            <input asp-for="Description" class="form-control" />
                        </div>

                        <h5 class="mt-4">Danh mục</h5>

                        <div class="mb-3">
                            <label class="form-label">Danh mục</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option hidden selected>Chọn...</option>
                                @foreach (var cate in categoryDropdown)
                                {
                                    <option value="@cate.Id">@cate.Name</option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Thương hiệu</label>
                                <select asp-for="Brand" class="form-select">
                                    <option hidden selected>Chọn...</option>
                                    @foreach (var brand in FBS.Shared.Constants.GlobalConstants.Brands)
                                    {
                                        <option value="@brand">@brand</option>
                                    }
                                </select>
                            </div>

                            <div class="col-sm-6 mb-3">
                                <label class="form-label">Màu</label>
                                <select asp-for="Color" class="form-select">
                                    <option hidden selected>Chọn...</option>
                                    @foreach (var color in FBS.Shared.Constants.GlobalConstants.Color)
                                    {
                                        <option value="@color">@color</option>
                                    }
                                </select>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Thông tin chi tiết (phần 1)</label>
                    <textarea asp-for="DetailPart1" class="form-control" rows="4"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Thông tin chi tiết (phần 2)</label>
                    <textarea asp-for="DetailPart2" class="form-control" rows="4"></textarea>
                </div>
            </div>
           


       
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-body">

                        <h5>Hình ảnh sản phẩm</h5>

                   
                        <label class="form-label fw-bold">Ảnh chính</label>
                        <input asp-for="ImageFile"
                               type="file"
                               accept="image/*"
                               style="border:1px solid #ddd;padding:6px"
                               onchange="previewMain(event)" />

                        <div id="previewMainImage" class="mt-2"></div>

                        <hr />

                        
                        <label class="form-label fw-bold">Ảnh phụ (nhiều hình)</label>

                        <input asp-for="SubImageFiles"
                               type="file"
                               name="SubImageFiles"
                               id="SubImageFiles"
                               multiple
                               accept="image/*"
                               style="border:1px solid #ddd;padding:6px"
                               onchange="previewSub1(event)" />

                        <div id="previewSubImages" class="mt-2 d-flex flex-wrap"></div>
                        <label class="form-label fw-bold">Ảnh phụ 1</label>

                        <input asp-for="SubImageFiles"
                               type="file"
                               name="SubImageFiles"
                               id="SubImageFiles"
                               multiple
                               accept="image/*"
                               style="border:1px solid #ddd;padding:6px"
                               onchange="previewSub2(event)" />

                        <div id="previewSubImages" class="mt-2 d-flex flex-wrap"></div>

                        <label class="form-label fw-bold">Ảnh phụ 2</label>

                        <input asp-for="SubImageFiles"
                               type="file"
                               name="SubImageFiles"
                               id="SubImageFiles"
                               multiple
                               accept="image/*"
                               style="border:1px solid #ddd;padding:6px"
                               onchange="previewSub3(event)" />

                        <div id="previewSubImages" class="mt-2 d-flex flex-wrap"></div>

                       

                      

                        <h5 class="mt-4">Kích thước</h5>

                        <div class="form-group">
                            @foreach (var size in new[] { "36", "37", "38", "39", "40", "41", "42", "43", "S", "M", "L", "XL", "2XL" })
                            {
                                <label class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="Sizes" value="@size" />
                                    <span class="form-check-label">@size</span>
                                </label>
                            }
                        </div>

                        <div class="mt-3 mb-3">
                            <label class="form-label">Giá</label>
                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0" />
                        </div>

                        <div class="mt-3 mb-3">
                            <label class="form-label">Giảm giá (%)</label>
                            <input asp-for="Discount"
                                   class="form-control"
                                   type="number"
                                   step="1"
                                   min="0"
                                   max="100" />
                        </div>



                        <div class="text-end">
                            <button type="submit" class="btn btn-primary me-3">Thêm</button>
                            <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Hủy</a>
                        </div>

                    </div>
                </div>
            </div>

        </div>

    </form>
</div>




<script>
    function previewMain(event) {
        let container = document.getElementById("previewMainImage");
        container.innerHTML = "";

        let file = event.target.files[0];
        if (!file) return;

        let reader = new FileReader();
        reader.onload = e => {
            let img = document.createElement("img");
            img.src = e.target.result;
            img.style.width = "150px";
            img.style.height = "150px";
            img.style.objectFit = "cover";
            img.style.borderRadius = "8px";
            container.appendChild(img);
        };
        reader.readAsDataURL(file);
    }

    function previewSub(event) {
        let container = document.getElementById("previewSubImages");
        container.innerHTML = "";

        Array.from(event.target.files).forEach(f => {
            let reader = new FileReader();
            reader.onload = e => {
                let img = document.createElement("img");
                img.src = e.target.result;
                img.style.width = "120px";
                img.style.height = "120px";
                img.style.objectFit = "cover";
                img.style.borderRadius = "8px";
                img.style.margin = "5px";
                container.appendChild(img);
            };
            reader.readAsDataURL(f);
        });
    }
</script>
