@using FBS.Application.DataTranferObjects.Cart

@{
    ViewData["Title"] = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cart = (List<CartItemDto>)ViewData["Cart"] ?? new List<CartItemDto>();
}

<div class="mn-breadcrumb m-b-30">
    <h2 class="mn-breadcrumb-title">Giỏ hàng</h2>
</div>

<section class="mn-cart-section p-b-15">
    <div class="row">
        <div class="col-lg-12">
            <div class="mn-cart-content">
                <div class="mn-cart-inner cart_list">

                    <div class="table-content cart-table-content">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Size</th>
                                    <th>Giá</th>
                                    <th style="text-align:center;">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (cart.Any())
                                {
                                    foreach (var item in cart)
                                    {
                                        <tr class="mn-cart-product"
                                            data-product-id="@item.ProductId"
                                            data-size="@item.Size">

                                            <td>
                                                <img src="@Url.Content("~/theme/client/img/product/" + item.Image)"
                                                     style="width:60px;height:60px;border-radius:6px;margin-right:6px" />
                                                @item.ProductName
                                            </td>

                                            <td>@item.Size</td>

                                            <!-- PRICE -->
                                            <td class="mn-cart-pro-price">
                                                <span class="amount">@item.PriceString</span>
                                            </td>

                                            <!-- QTY -->
                                            <td style="text-align:center;">
                                                <div class="quantity-box">
                                                    <button type="button" class="qty-btn minus">−</button>
                                                    <input class="qty-input" value="@item.Quantity" readonly />
                                                    <button type="button" class="qty-btn plus">+</button>
                                                </div>
                                               
                                                <div class="qty-warning text-danger mt-1"
                                                     style="display:none;font-size:13px;">
                                                     Số lượng lớn hơn 10 sản phẩm.<br />
                                                    Vui lòng <b>liên hệ shop</b>.
                                                </div>
                                            </td>
                                        
                                            <td class="mn-cart-pro-subtotal">
                                                @item.SubPriceString
                                            </td>

                                            <!-- REMOVE -->
                                            <td>
                                                <form asp-action="RemoveFromCart" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="hidden" name="size" value="@item.Size" />
                                                    <button type="submit" class="btn-remove">
                                                        <i class="ri-delete-bin-line text-danger"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            Giỏ hàng của bạn hiện chưa có sản phẩm
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mn-cart-update-bottom">
                        <a asp-action="List" asp-controller="Product">
                            Tiếp tục mua sắm
                        </a>

                        <a asp-action="Checkout"
                           asp-controller="Cart"
                           class="mn-btn-2 @(cart.Any() ? "" : "disabled")">
                            Thanh toán
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>





<style>
    .mn-btn-2.disabled {
        pointer-events: none;
        opacity: 0.5;
    }

    .quantity-box {
        display: flex;
        gap: 6px;
        align-items: center;
        justify-content: center;
    }

    .qty-btn {
        width: 30px;
        height: 30px;
        border: 1px solid #ccc;
        border-radius: 6px;
        background: #f3f3f3;
        font-size: 18px;
        cursor: pointer;
    }

    .qty-input {
        width: 45px;
        height: 30px;
        border: 1px solid #ddd;
        border-radius: 6px;
        text-align: center;
    }

    .btn-remove {
        background: none;
        border: none;
        color: #ef4444;
        font-size: 18px;
        cursor: pointer;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function formatMoney(n) {
                return n.toLocaleString("vi-VN") + " đ";
            }

            function updateServerQuantity(productId, size, quantity) {
                const token = document.querySelector("input[name='__RequestVerificationToken']")?.value;

                fetch("/Cart/UpdateQuantity", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "RequestVerificationToken": token
                    },
                    body: `productId=${productId}&size=${size}&quantity=${quantity}`
                });
            }

            document.querySelectorAll(".mn-cart-product").forEach(row => {

                const plusBtn = row.querySelector(".plus");
                const minusBtn = row.querySelector(".minus");
                const qtyInput = row.querySelector(".qty-input");
                const subtotalCell = row.querySelector(".mn-cart-pro-subtotal");
                const warning = row.querySelector(".qty-warning");

                const priceText = row.querySelector(".amount").innerText;
                const price = parseInt(priceText.replace(/\D/g, ""));

                const productId = row.dataset.productId;
                const size = row.dataset.size;

                plusBtn.addEventListener("click", () => {
                    let qty = parseInt(qtyInput.value);

                    // ❌ CHẶN > 10
                    if (qty >= 10) {
                        warning.style.display = "block";
                        return;
                    }

                    qty++;
                    qtyInput.value = qty;
                    warning.style.display = "none";

                    subtotalCell.innerText = formatMoney(price * qty);
                    updateServerQuantity(productId, size, qty);
                });

                minusBtn.addEventListener("click", () => {
                    let qty = parseInt(qtyInput.value);

                    if (qty > 1) {
                        qty--;
                        qtyInput.value = qty;
                        warning.style.display = "none";

                        subtotalCell.innerText = formatMoney(price * qty);
                        updateServerQuantity(productId, size, qty);
                    }
                });
            });
        });
    </script>
}



