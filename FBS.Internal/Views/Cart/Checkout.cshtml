@using FBS.Application.DataTranferObjects.Cart
@model CheckoutDto
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cart = (List<CartItemDto>)ViewData["Cart"] ?? new List<CartItemDto>();
    decimal shipping = 30000m;
    decimal subtotal = cart.Sum(x => (x.Price ?? 0m) * x.Quantity);
    decimal total = subtotal + shipping;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white p-3 shadow-sm rounded">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            </li>
            <li class="breadcrumb-item active">Thanh toán</li>
        </ol>
    </nav>

    <div class="row g-4">
      
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Thông tin giao hàng</h5>
                </div>

           
                <form asp-action="Checkout" asp-controller="Cart" method="post" class="card-body p-4">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row gy-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Họ tên *</label>
                            <input asp-for="FullName" class="form-control form-control-lg" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số điện thoại *</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Địa chỉ *</label>
                            <input asp-for="Address" class="form-control form-control-lg" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Ghi chú</label>
                            <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                   
                    <div class="col-12 mt-4">
                        <div class="payment-section card shadow-sm border-0">
                            <div class="card-header bg-secondary text-white py-3">
                                <h5 class="mb-0">
                                    <i class="ri-wallet-3-line me-1"></i> Hình thức thanh toán
                                </h5>
                            </div>

                            <div class="card-body p-4">
                                <label class="payment-option w-100">
                                    <input type="radio" asp-for="PaymentMethod" value="COD" checked />
                                    <div class="payment-box">
                                        <div class="payment-icon cod">
                                            <i class="ri-truck-line"></i>
                                        </div>
                                        <div>
                                            <div class="payment-title">Thanh toán khi nhận hàng (COD)</div>
                                            <div class="payment-desc">Nhận hàng xong mới thanh toán</div>
                                        </div>
                                    </div>
                                </label>

                                <label class="payment-option w-100">
                                    <input type="radio" asp-for="PaymentMethod" value="VietQR" />
                                    <div class="payment-box">
                                        <div class="payment-icon qr">
                                            <i class="ri-qr-code-line"></i>
                                        </div>
                                        <div>
                                            <div class="payment-title">Thanh toán bằng VietQR</div>
                                            <div class="payment-desc">Quét QR Code bằng app ngân hàng</div>
                                        </div>
                                    </div>
                                </label>

                                
                              
                                    <div id="qr-preview" class="text-center mt-4" style="display:none">
                                        <img src="https://img.vietqr.io/image/VCB-1026869227-compact.png?amount=@total"
                                             style="width:200px;height:200px" />
                                        <p class="fw-bold text-primary mt-2">
                                            Tổng tiền: @total.ToString("N0") đ
                                        </p>
                                    </div>
                                
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="ShippingFee" value="@shipping" />


                    <div class="col-12 mt-4">
                        <button type="submit"
                                class="btn btn-primary w-100 py-3 fw-bold fs-5">
                            ĐẶT HÀNG NGAY
                        </button>
                    </div>
                    <input type="hidden" asp-for="PaymentMethod" />

                </form>
            </div>
        </div>

       
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Tóm tắt đơn hàng</h5>
                </div>

                <div class="card-body p-4">
                    @foreach (var item in cart)
                    {
                        <div class="d-flex mb-3 pb-3 border-bottom">
                            <img src="@Url.Content("~/theme/client/img/product/" + item.Image)"
                                 style="width:60px;height:60px;object-fit:cover;border-radius:6px" />
                            <div class="flex-grow-1 ms-2">
                                <div class="fw-bold">@item.ProductName</div>
                                <div class="small text-muted"> Size: <b>@item.Size</b> </div>
                                <div class="small">SL: @item.Quantity</div>
                                <div class="text-primary fw-bold">@item.SubPriceString</div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính</span>
                        <span>@subtotal.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí ship</span>
                        <span>@shipping.ToString("N0") đ</span>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between fw-bold text-primary fs-5">
                        <span>Tổng tiền</span>
                        <span>@total.ToString("N0") đ</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-option {
        display: block;
        cursor: pointer;
        margin-bottom: 15px;
        width: 100%;
    }

        .payment-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }


    .payment-box {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 16px;
        border: 2px solid #e3e3e3;
        border-radius: 12px;
        background: #fff;
        transition: all .25s ease;
    }

    .payment-option:hover .payment-box {
        border-color: #2f6bff;
        background: #f5f9ff;
    }

    .payment-option input:checked + .payment-box {
        border-color: #2f6bff;
        background: #eef4ff;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

    .payment-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

        .payment-icon.cod {
            background: #e3f2fd;
            color: #0d6efd;
        }

        .payment-icon.qr {
            background: #fff4e5;
            color: #ff8b2c;
        }

    .payment-title {
        font-size: 16px;
        font-weight: 700;
    }

    .payment-desc {
        font-size: 13px;
        color: #555;
        margin-top: 2px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.querySelector("form");

            const codRadio = document.querySelector('input[name="PaymentMethod"][value="COD"]');
            const qrRadio  = document.querySelector('input[name="PaymentMethod"][value="VietQR"]');
            const qrBox    = document.getElementById("qr-preview");

            const hiddenPayment = document.querySelector('input[type="hidden"][name="PaymentMethod"]');

           
            function toggleQr() {
                if (!qrBox) return;
                qrBox.style.display = qrRadio.checked ? "block" : "none";

               
                if (hiddenPayment) {
                    hiddenPayment.value = qrRadio.checked ? "VietQR" : "COD";
                }
            }

            codRadio.addEventListener("change", toggleQr);
            qrRadio.addEventListener("change", toggleQr);

            toggleQr();

           
            form.addEventListener("submit", function (e) {

                if (!$(form).valid()) {
                    e.preventDefault();
                    return;
                }

                const payment = hiddenPayment
                    ? hiddenPayment.value
                    : document.querySelector('input[name="PaymentMethod"]:checked').value;

                let message = payment === "VietQR"
                    ? "Bạn xác nhận đặt hàng và sẽ thanh toán bằng VietQR?"
                    : "Bạn xác nhận đặt hàng (Thanh toán khi nhận hàng)?";

                if (!confirm(message)) {
                    e.preventDefault();
                }
            });
        });
    </script>
}



