@using FBS.Application.DataTranferObjects.Cart

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cart = (List<CartItemDto>)ViewData["Cart"];
}
@model CheckoutDto

<div class="mn-breadcrumb m-b-30">
    <div class="row">
        <div class="col-12">
            <div class="row gi_breadcrumb_inner">
                <div class="col-md-6 col-sm-12">
                    <h2 class="mn-breadcrumb-title">Thanh toán</h2>
                </div>
                <div class="col-md-6 col-sm-12">
                    <ul class="mn-breadcrumb-list">
                        <li class="mn-breadcrumb-item"><a asp-action="Index" asp-controller="Home">Trang chủ</a></li>
                        <li class="mn-breadcrumb-item active">Thanh toán</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<section class="mn-checkout-section p-b-15">
    <h2 class="d-none">Checkout Page</h2>
    <div class="row">
        <div class="mn-checkout-leftside col-lg-8 col-md-12">
            <!-- checkout content Start -->
            <div class="mn-checkout-content">
                <div class="mn-checkout-inner">
                    <form asp-action="Checkout" asp-controller="Cart" method="post">
                        <div class="mn-checkout-wrap m-b-30 padding-bottom-3">
                            <div class="mn-checkout-block mn-check-bill">
                                <h3 class="mn-checkout-title">Thông tin giao hàng</h3>
                                <div class="mn-bl-block-content">
                                    <div class="mn-check-bill-form">
                                        <span class="mn-bill-wrap mn-bill-half">
                                            <label>Họ tên*</label>
                                            <input type="text" 
                                                   placeholder="Họ tên" asp-for="FullName">
                                        </span>
                                        <span class="mn-bill-wrap mn-bill-half">
                                            <label>Số điện thoại*</label>
                                            <input type="text" 
                                                   placeholder="Số điện thoại" asp-for="PhoneNumber">
                                        </span>
                                        <span class="mn-bill-wrap">
                                            <label>Địa chỉ</label>
                                            <input type="text"  asp-for="Address" placeholder="Địa chỉ">
                                        </span>
                                        <span class="mn-bill-wrap">
                                            <label>Ghi chú</label>
                                            <input type="text" asp-for="Note" placeholder="Địa chỉ">
                                        </span>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <span class="mn-check-order-btn m-t-30">
                            <button type="submit" class="mn-btn-2"><span>Đặt hàng</span></button>
                        </span>
                    </form>

                </div>
            </div>
            <!--cart content End -->
        </div>
        <!-- Sidebar Area Start -->
        <div class="mn-checkout-rightside col-lg-4 col-md-12 m-t-991">
            <div class="mn-sidebar-wrap">
                <!-- Sidebar Summary Block -->
                <div class="mn-sidebar-block">
                    <div class="mn-sb-title">
                        <h3 class="mn-sidebar-title">Tóm tắt</h3>
                    </div>
                    <div class="mn-sb-block-content">
                        <div class="mn-checkout-summary">
                            <div>
                                <span class="text-left">Tạm tính</span>
                                <span class="text-right">$295.00</span>
                            </div>
                            <div>
                                <span class="text-left">Phí vận chuyển</span>
                                <span class="text-right">$80.00</span>
                            </div>

                            <div class="mn-checkout-summary-total">
                                <span class="text-left">Tổng tiền</span>
                                <span class="text-right">$375.00</span>
                            </div>
                        </div>
                        <div class="mn-checkout-pro">
                            @foreach (var item in cart)
                            {
                                <div class="col-sm-12 mb-6">
                                    <div class="mn-product-inner">
                                        <div class="mn-pro-image-outer">
                                            <div class="mn-pro-image">
                                                <a href="product-detail.html" class="image">
                                                    <img class="main-image" src="~/theme/client/img/giay/29.jpg"
                                                         alt="Product">
                                                    <img class="hover-image" src="~/theme/client/img/giay/30.jpg"
                                                         alt="Product">
                                                </a>
                                            </div>
                                        </div>
                                        <div class="mn-pro-content">
                                            <h5 class="mn-pro-title">
                                                <a target="_blank" asp-controller="Product" asp-action="Detail" asp-route-id="@item.ProductId">@item.ProductName</a>
                                            </h5>
                                            <span>Size: @item.Size - Màu: @item.Color</span>
                                            <span class="mn-price">
                                                <span class="price">
                                                    <span class="text-sm">Số lượng: @(item.Quantity)</span>
                                                </span>
                                                <span class="new-price">@item.SubPriceString</span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <!-- Sidebar Summary Block -->
            </div>

            <div class="mn-sidebar-wrap mn-checkout-del-wrap">
                <!-- Sidebar Payment Block -->
                <div class="mn-sidebar-block">
                    <div class="mn-sb-title">
                        <h3 class="mn-sidebar-title">Hình thức thành toán</h3>
                    </div>
                    <div class="mn-sb-block-content">
                        <div class="mn-checkout-pay">
                            <div class="mn-pay-desc">
                                Please select the preferred payment method to use
                                on this
                                order.
                            </div>
                            <form action="checkout.html#">
                                <span class="mn-pay-option m-b-15">
                                    <span>
                                        <input type="radio" id="pay1" name="radio-group" checked>
                                        <label for="pay1">Thanh toán khi nhận hàng</label>
                                    </span>
                                </span>
                                <span class="mn-pay-commemt">
                                    <span class="mn-pay-opt-head">Ghi chú</span>
                                    <textarea name="your-commemt" placeholder="Comments"></textarea>
                                </span>
                                <span class="mn-pay-agree">
                                    <input type="checkbox" value="">
                                    Đồng ý với <a href="checkout.html#">chính sách và bảo mật.</a>
                                    <span class="checked"></span>
                                </span>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

