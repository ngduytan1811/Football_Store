@model List<FBS.Application.DataTranferObjects.Blog.BlogDto>

@{
    ViewData["Title"] = "Bài viết mới nhất";
}

<style>
    .blog-card img {
        height: 220px;
        object-fit: cover;
        border-top-left-radius: .5rem;
        border-top-right-radius: .5rem;
    }

    .blog-card:hover {
        transform: translateY(-4px);
        transition: .2s;
        box-shadow: 0 10px 25px rgba(0,0,0,.1);
    }

    .blog-title {
        font-size: 1.2rem;
        font-weight: 600;
        line-height: 1.4;
        color: #222;
    }

        .blog-title:hover {
            color: #0d6efd;
        }

    .blog-author {
        font-size: .9rem;
        color: #777;
    }
</style>

<div class="container py-4">

    <h2 class="fw-bold mb-4 text-center">
        Tin tức & Bài viết nổi bật
    </h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Hiện chưa có bài viết nào.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var blog in Model)
            {
                <div class="col-md-4">
                    <div  class="card blog-card shadow-sm h-100">

                        <a href="/blogs/detail/@blog.Id">
                            <img src="/@blog.Thumbnail" class="card-img-top" />
                        </a>

                        <div class="card-body">
                            <a href="/blogs/detail/@blog.Id" class="text-decoration-none">
                                <h5 class="blog-title">@blog.Title</h5>
                            </a>

                            <p class="blog-author mt-2">
                                <i class="bi bi-person"></i> @blog.Author
                                <br />
                                <i class="bi bi-clock"></i>
                                @blog.CreatedAt?.ToString("dd/MM/yyyy")

                            </p>

                            <a href="/blogs/detail/@blog.Id">Đọc thêm</a>


                        </div>   
                    </div>
                </div>
            }
        </div>
    }
</div>
