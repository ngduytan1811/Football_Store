@model FBS.Application.DataTranferObjects.Blog.BlogDto

<div class="container mt-5" style="max-width:900px;">

    
    <h1 class="fw-bold mb-3">@Model.Title</h1>

  
    <p class="text-muted">
        @Model.Author — @(Model.CreatedAt?.ToString("dd/MM/yyyy") ?? "")

    </p>

   
    @if (!string.IsNullOrEmpty(Model.Thumbnail))
    {
        <img src="/@Model.Thumbnail"
             class="img-fluid rounded mb-4"
             style="width:100%;object-fit:cover;" />
    }

  
    @{
        var parts = (Model.Content ?? "").Split("<!--IMG-BLOCK-->");
        string c1 = parts.Length > 0 ? parts[0] : "";
        string c2 = parts.Length > 1 ? parts[1] : "";
    }

 
    <div class="content mb-4" style="font-size:18px;line-height:1.7;">
        @Html.Raw(c1)
    </div>

    @if (Model.Images != null && Model.Images.Count > 0)
    {
        <img src="/@Model.Images[0]"
             class="img-fluid rounded mb-4"
             style="width:100%;object-fit:cover;" />
    }

  
    <div class="content mb-4" style="font-size:18px;line-height:1.7;">
        @Html.Raw(c2)
    </div>

  
    @if (Model.Images != null && Model.Images.Count > 1)
    {
        for (int i = 1; i < Model.Images.Count; i++)
        {
            <img src="/@Model.Images[i]"
                 class="img-fluid rounded mb-4"
                 style="width:100%;object-fit:cover;" />
        }
    }

</div>
