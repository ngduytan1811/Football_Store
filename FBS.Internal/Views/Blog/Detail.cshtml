@model FBS.Application.DataTranferObjects.Blog.BlogDto

@{
    ViewData["Title"] = Model?.Title ?? "Chi tiết bài viết";
}

<style>
    .blog-container {
        max-width: 900px;
        margin: auto;
    }

    .blog-content {
        font-size: 1.15rem;
        line-height: 1.9;
        color: #333;
        background: #fff;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0px 4px 20px rgba(0,0,0,0.05);
    }

        .blog-content p {
            margin-bottom: 18px;
        }

        .blog-content img {
            max-width: 100%;
            border-radius: 8px;
            margin: 20px 0;
        }

        /* Typography đẹp */
        .blog-content h2,
        .blog-content h3 {
            margin-top: 32px;
            margin-bottom: 16px;
            font-weight: 700;
        }

        /* First letter style */
        .blog-content p:first-child:first-letter {
            float: left;
            font-size: 3.2rem;
            line-height: 1;
            padding-right: 10px;
            padding-top: 5px;
            color: #0d6efd;
            font-weight: bold;
        }
</style>

<div class="container py-4 blog-container">

    <a href="/blog" class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>

    <h1 class="fw-bold mb-2">@Model.Title</h1>

    <div class="text-muted mb-4">
        <i class="bi bi-person"></i> @Model.Author
        &nbsp; | &nbsp;
        <i class="bi bi-clock"></i> @Model.CreatedAt?.ToString("dd/MM/yyyy")
    </div>

    <img src="/@Model.Thumbnail" class="img-fluid rounded shadow-sm mb-4" />

    <div class="blog-content">
        @Html.Raw(Model.Content)  <!-- Nội dung được styled đẹp -->
    </div>

</div>
