@model FBS.Application.DataTranferObjects.Blog.BlogDto

<div class="container mt-5" style="max-width:900px;">

    
    <h1 class="fw-bold mb-3">@Model.Title</h1>

  
    <p class="text-muted">
        @Model.Author — @(Model.CreatedAt?.ToString("dd/MM/yyyy") ?? "")

    </p>



    @if (!string.IsNullOrEmpty(Model.Thumbnail))
    {
        <div class="blog-thumb-wrapper">
            <img src="/@Model.Thumbnail"
                 class="img-fluid blog-thumb-img"
                 />

            @if (Model.ProductId.HasValue)
            {
                <a asp-controller="Product"
                   asp-action="Detail"
                   asp-route-id="@Model.ProductId"
                   class="btn-buy-now">
                    <i class="bi bi-cart3"></i> Mua ngay
                </a>
            }
        </div>
    }

  
    @{
        var parts = (Model.Content ?? "").Split("<!--IMG-BLOCK-->");
        string c1 = parts.Length > 0 ? parts[0] : "";
        string c2 = parts.Length > 1 ? parts[1] : "";
    }

 
    <div class="content mb-4" style="font-size:18px;line-height:1.7;">
        @Html.Raw(c1)
    </div>

    @if (Model.Images != null && Model.Images.Count > 0)
    {
        <img src="/@Model.Images[0]"
             class="img-fluid rounded mb-4"
             style="width:100%;object-fit:cover;" />
    }

  
    <div class="content mb-4" style="font-size:18px;line-height:1.7;">
        @Html.Raw(c2)
    </div>

  
    @if (Model.Images != null && Model.Images.Count > 1)
    {
        for (int i = 1; i < Model.Images.Count; i++)
        {
            <img src="/@Model.Images[i]"
                 class="img-fluid rounded mb-4"
                 style="width:100%;object-fit:cover;" />
        }
    }

</div>
<style>
    .blog-thumb-wrapper {
        position: relative;
        border-radius: 18px;
        overflow: hidden;
       
      
    }

    .blog-thumb-img {
        width: 100%;
        object-fit: cover;
        display: block;
    }

    
    .btn-buy-now {
        position: absolute;
        bottom: 22px;
        left: 22px;
        padding: 14px 32px;
        border-radius: 999px;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: .3px;
        color: gray;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient( 135deg, rgba(60, 60, 60, 0.85), rgba(30, 30, 30, 0.75) );
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35), inset 0 0 0 1px rgba(255, 255, 255, 0.15);
        transition: all .3s cubic-bezier(.4,0,.2,1);
    }

      
        .btn-buy-now:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.25);
            color: #fff;
        }


</style>
