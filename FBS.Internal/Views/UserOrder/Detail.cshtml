@model FBS.Application.DataTranferObjects.Orders.OrderDto

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var total = Model.OrderItems.Sum(x => (x.Price ?? 0) * x.Quantity);
}

<h3 class="fw-bold mb-4">Chi tiết đơn hàng</h3>

<div class="card shadow-sm p-4">

    <p><b>Mã đơn hàng:</b> @Model.Id</p>

    <p><b>Họ tên:</b> @Model.CustomerName</p>
    <p><b>Số điện thoại:</b> @Model.CustomerPhone</p>
    <p><b>Địa chỉ:</b> @Model.CustomerAddress</p>
    <p><b>Ghi chú:</b> @Model.Note</p>

    <hr />

    <h5 class="fw-bold mb-3">Sản phẩm</h5>

    <table class="table table-bordered bg-white">
        <thead class="bg-light fw-bold">
            <tr>
                <th style="width:120px;">Ảnh</th>
                <th>Tên SP</th>
                <th>Size</th>
                <th>Màu</th>
                <th>SL</th>
                <th>Giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                var sub = (item.Price ?? 0) * item.Quantity;
                   
                
                <td>
                    <img src="~/uploads/products/@item.ProductImage"
                         class="img-thumbnail"
                         style="width: 80px; height: 80px; object-fit: cover;" />
                </td>

                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.ProductSize</td>
                    <td>@item.ProductColor</td>
                    <td>@item.Quantity</td>
                    <td>
                        @(item.Price.GetValueOrDefault().ToString("N0")) đ
                    </td>
                    <td>
                        @(Convert.ToDecimal(item.Price).ToString("N0")) đ

                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3 text-end">
        <h4 class="fw-bold text-primary">
            Tổng tiền: @(Convert.ToDecimal(total).ToString("N0")) đ

        </h4>
    </div>

</div>

<a href="/UserOrder" class="btn btn-secondary mt-3">Quay lại</a>
