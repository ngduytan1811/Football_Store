@using FBS.Shared.Helpers
@using FBS.Shared.Enums
@model FBS.Application.DataTranferObjects.Orders.OrderDto

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var total = Model.OrderItems.Sum(x => (x.Price ?? 0) * (x.Quantity ?? 0));
}

<h3 class="fw-bold mb-4">Chi tiết đơn hàng</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow-sm p-4">
    @if (Model.Status == StatusEnum.Inactive || Model.Status == StatusEnum.Active)
    {
        <form asp-action="UpdateInfo" method="post">
            <input type="hidden" name="OrderId" value="@Model.Id" />

            <div class="mb-3">
                <label>Họ tên</label>
                <input asp-for="CustomerName" name="CustomerName" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Số điện thoại</label>
                <input asp-for="CustomerPhone" name="CustomerPhone" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Địa chỉ</label>
                <input asp-for="CustomerAddress" name="CustomerAddress" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Ghi chú</label>
                <textarea asp-for="Note" name="Note" class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Cập nhật thông tin
            </button>
        </form>
    }
    else{
    <p><b>Mã đơn hàng:</b> @Model.Id</p>
    <p><b>Họ tên:</b> @Model.CustomerName</p>
    <p><b>Số điện thoại:</b> @Model.CustomerPhone</p>
    <p><b>Địa chỉ:</b> @Model.CustomerAddress</p>
    <p><b>Ghi chú:</b> @Model.Note</p>
    }
    <p>
        <b>Trạng thái:</b>
        <span class="badge
            @(Model.Status == StatusEnum.Cancel ? "bg-secondary" :
              Model.Status == StatusEnum.InHandler ? "bg-info" :
              Model.Status == StatusEnum.Active ? "bg-success" :
              "bg-warning")">
            @Model.Status?.GetDisplayName()
        </span>
    </p>

    <hr />
    <h5 class="fw-bold mb-3">Theo dõi đơn hàng</h5>

    @if (Model.StatusHistories != null && Model.StatusHistories.Any())
    {
        <ul class="order-timeline">
            @foreach (var item in Model.StatusHistories)
            {
                <li class="done">
                    <div>
                        <b>@item.Status.GetDisplayName()</b>
                        <small class="text-muted">
                            (@item.CreatedAt.ToString("dd/MM HH:mm"))
                        </small>
                    </div>
                    <div class="text-muted">@item.Note</div>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="text-muted">Chưa có thông tin theo dõi.</div>
    }


    <h5 class="fw-bold mb-3">Sản phẩm</h5>

    <table class="table table-bordered bg-white">
        <thead class="bg-light fw-bold">
            <tr>
                <th style="width:120px;">Ảnh</th>
                <th>Tên SP</th>
                <th>Size</th>
                <th>Màu</th>
                <th>SL</th>
                <th>Giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                var sub = (item.Price ?? 0) * (item.Quantity ?? 0);

                <tr>
                    <td>
                        <img src="@Url.Content("~/theme/client/img/product/" + item.ProductImage)"
                             class="img-thumbnail"
                             style="width:80px;height:80px;object-fit:cover;" />
                    </td>
                    <td>@item.ProductName</td>
                    <td>@item.ProductSize</td>
                    <td>@item.ProductColor</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price.GetValueOrDefault().ToString("N0") đ</td>
                    <td>@sub.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3 text-end">
        @{
            var productTotal = Model.OrderItems
            .Sum(x => (x.Price ?? 0) * (x.Quantity ?? 0));
        }

        <div class="mt-3 text-end">
            <p>Tạm tính: <b>@productTotal.ToString("N0") đ</b></p>
            <p>Phí vận chuyển: <b>@Model.ShippingFee.ToString("N0") đ</b></p>
            <hr />
            <h4 class="fw-bold text-primary">
                Tổng cộng: @((productTotal + Model.ShippingFee).ToString("N0")) đ
            </h4>

        </div>

    </div>

    <hr />

    @if (Model.Status == StatusEnum.Inactive ||
    Model.Status == StatusEnum.Active)
    {
        <form asp-action="Cancel"
              asp-controller="UserOrder"
              method="post"
              onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-danger">Hủy đơn hàng</button>
        </form>
    }


</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Quay lại</a>
 
<style>
    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
    }
    .order-timeline {
    list-style: none;
    padding-left: 20px;
    position: relative;
}

.order-timeline::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e0e0e0;
}

.order-timeline li {
    position: relative;
    padding: 12px 0 12px 25px;
}

.order-timeline li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18px;
    width: 14px;
    height: 14px;
    background: #198754;
    border-radius: 50%;
}

</style>
