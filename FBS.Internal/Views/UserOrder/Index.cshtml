@using FBS.Shared.Helpers
@using FBS.Shared.Enums
@model List<FBS.Application.DataTranferObjects.Orders.OrderDto>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<h2 class="fw-bold mb-4">Đơn hàng của tôi</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm">
        Bạn chưa có đơn hàng nào.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle order-table shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ngày đặt</th>
                    <th>Tên khách</th>
                    <th>SĐT</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int index = 1;
                }

                @foreach (var order in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td>@order.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.CustomerName</td>
                        <td>@order.CustomerPhone</td>

                        <!-- ===== TRẠNG THÁI ===== -->
                        <td class="text-center">
                            <span class="badge
                                @(order.Status == StatusEnum.Cancel ? "bg-secondary" :
                                  order.Status == StatusEnum.InHandler ? "bg-info" :
                                  order.Status == StatusEnum.Active ? "bg-danger" :
                                  "bg-success")">
                                @order.Status?.GetDisplayName()
                            </span>
                        </td>

                        <!-- ===== THAO TÁC ===== -->
                        <td class="text-center">
                            <a asp-action="Detail"
                               asp-route-id="@order.Id"
                               class="btn btn-primary btn-sm px-3">
                                Xem chi tiết
                            </a>

                            @* CHỈ CHO HỦY KHI:
                               - KHÔNG phải Đang giao
                               - KHÔNG phải Giao thành công
                               - KHÔNG phải Đã hủy *@
                            @if (order.Status == StatusEnum.Inactive ||
                           order.Status == StatusEnum.Active)
                            {
                                <form asp-action="Cancel"
                                      asp-controller="UserOrder"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">

                                    <input type="hidden" name="id" value="@order.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm ms-2">
                                        Hủy đơn
                                    </button>
                                </form>
                            }

                        </td>
                    </tr>

                    index++;
                }
            </tbody>
        </table>
    </div>
}

<style>
    .order-table {
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
    }

        .order-table tbody tr:hover {
            background: #f8f9fa !important;
        }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
    }

    .btn-primary, .btn-danger {
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
    }
</style>
