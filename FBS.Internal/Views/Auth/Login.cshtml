@using FBS.Application.DataTranferObjects.Auth

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model LoginDto

<style>
    input[type="text"],
    input[type="password"],
    input {
        color: #000 !important;
    }

        input::placeholder {
            color: #999 !important;
        }
</style>

<div class="mn-breadcrumb m-b-30">
    <div class="row">
        <div class="col-12">
            <div class="row gi_breadcrumb_inner">
                <div class="col-md-6 col-sm-12">
                    <h2 class="mn-breadcrumb-title">Đăng nhập</h2>
                </div>
                <div class="col-md-6 col-sm-12">
                    <ul class="mn-breadcrumb-list">
                        <li class="mn-breadcrumb-item"><a asp-action="Index" asp-controller="Home">Trang chủ</a></li>
                        <li class="mn-breadcrumb-item active">Đăng nhập</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="mn-login p-b-15">
    <div class="mn-login-content">
        <div class="mn-login-box">
            <div class="mn-login-wrapper">
                <div class="mn-login-container">
                    <div class="mn-login-form">

                     
                        <form asp-action="Login" asp-controller="Auth" method="post" asp-antiforgery="true">

                            <div class="alert alert-danger dark" asp-validation-summary="ModelOnly"></div>

                            <span class="mn-login-wrap">
                                <label>Tài khoản*</label>
                                <span asp-validation-for="Username" class="text-danger"></span>
                                <input type="text" asp-for="Username" placeholder="Nhập tài khoản...">
                            </span>

                            <span class="mn-login-wrap">
                                <label>Mật khẩu*</label>
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <input type="password" asp-for="Password" placeholder="Nhập mật khẩu...">
                            </span>

                            <span class="mn-login-wrap mn-login-fp">
                                <span class="mn-remember">
                                  
                                    Ghi nhớ đăng nhập
                                    <span class="checked"></span>
                                </span>
                                <label><a href="#">Quên mật khẩu?</a></label>
                            </span>

                            <span class="mn-login-wrap mn-login-btn">
                                <span><a asp-action="Register" asp-controller="Auth">Tạo tài khoản?</a></span>
                                <button class="mn-btn-1 btn" type="submit"><span>Đăng nhập</span></button>
                            </span>

                        </form>

                    </div>
                </div>
            </div>
        </div>

        <div class="mn-login-box d-n-991">
        </div>
    </div>
</section>
