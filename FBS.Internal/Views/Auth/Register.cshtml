@using FBS.Application.DataTranferObjects.Users

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model UserSaveDto

<div class="mn-breadcrumb m-b-30">
    <div class="row">
        <div class="col-12">
            <div class="row gi_breadcrumb_inner">
                <div class="col-md-6 col-sm-12">
                    <h2 class="mn-breadcrumb-title">Đăng ký</h2>
                </div>
                <div class="col-md-6 col-sm-12">
                    <ul class="mn-breadcrumb-list">
                        <li class="mn-breadcrumb-item"><a asp-action="Index" asp-controller="Home">Trang chủ</a></li>
                        <li class="mn-breadcrumb-item active">Đăng ký</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="mn-register p-b-15">
    <div class="row">
        <div class="mn-register-wrapper">
            <div class="mn-register-container">
                <div class="mn-register-form">
                    <form asp-action="Register" asp-controller="Auth" method="post">
                        <div class="alert alert-danger dark" asp-validation-summary="ModelOnly">
                        </div>
                        <span class="mn-register-wrap">
                            <label>Tài khoản*</label>
                            <span asp-validation-for="UserName" class="text-danger"></span>
                            <input type="text" asp-for="UserName" placeholder="Nhập tên tài khoản...">
                        </span>
                        <span class="mn-register-wrap mn-register-half">
                            <label>Họ*</label>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                            <input type="text" asp-for="FirstName" placeholder="Nhập họ...">
                        </span>
                        <span class="mn-register-wrap mn-register-half">
                            <label>Tên*</label>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                            <input type="text" asp-for="LastName" placeholder="Nhập tên...">
                        </span>
                        <span class="mn-register-wrap mn-register-half">
                            <label>Email*</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                            <input type="email" asp-for="Email" placeholder="Nhập địa chỉ email...">
                        </span>
                        <span class="mn-register-wrap mn-register-half">
                            <label>Số điện thoại*</label>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            <input type="text" asp-for="PhoneNumber" placeholder="Nhập số điện thoại...">
                        </span>
                        <span class="mn-register-wrap">
                            <label>Địa chỉ</label>
                            <input type="text" asp-for="Address" placeholder="Nhập địa chỉ...">
                        </span>

                        <span class="mn-register-wrap mn-register-btn">
                            <span>Nếu đã có tài khoản?<a asp-action="Login" asp-controller="Auth">Đăng nhập</a></span>
                            <button class="mn-btn-1" type="submit"><span>Đăng ký</span></button>
                        </span>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

