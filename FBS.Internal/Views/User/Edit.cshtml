@model FBS.Internal.Models.CurrentUserViewModel
@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

<style>
    .edit-container {
        max-width: 650px;
        margin: 40px auto;
        background: #fff;
        padding: 30px 40px;
        border-radius: 12px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
    }

        .edit-container h3 {
            margin-bottom: 25px;
            font-weight: bold;
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            font-weight: 600;
        }

    .form-control {
        height: 42px;
    }

    .btn-save {
        background: #ff5722;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
    }

        .btn-save:hover {
            background: #e44f1c;
        }

    
    .custom-alert {
        padding: 14px 20px;
        border-radius: 10px;
        font-size: 15px;
        margin-bottom: 20px;
    }
</style>

<div class="edit-container">

    <h3>Chỉnh sửa thông tin</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success custom-alert">
            <strong>@TempData["Success"]</strong>
        </div>
    }

    <form asp-action="Edit" method="post">
        <div class="form-group">
            <label>Họ</label>
            <input asp-for="FirstName" class="form-control" />
        </div>

        <div class="form-group">
            <label>Tên</label>
            <input asp-for="LastName" class="form-control" />
        </div>

        <div class="form-group">
            <label>Số điện thoại</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="form-group">
            <label>Địa chỉ</label>
            <input asp-for="Address" class="form-control" />
        </div>

        <button class="btn-save" type="submit">Lưu thay đổi</button>
    </form>

</div>
