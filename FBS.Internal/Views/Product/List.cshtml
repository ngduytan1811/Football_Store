@using FBS.API.Responses.Base
@using FBS.Application.DataTranferObjects.Products


@{
    ViewData["Title"] = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var products = (BaseTableResponse<ProductDto>)ViewData["Products"];
    var searchData = (ProductSearchDto)ViewData["SearchData"];
}

<div class="mn-breadcrumb m-b-30">
    <div class="row">
        <div class="col-12">
            <div class="row gi_breadcrumb_inner">
                <div class="col-md-6 col-sm-12">
                    <h2 class="mn-breadcrumb-title">Sản phẩm</h2>
                </div>
                <div class="col-md-6 col-sm-12">
                    <ul class="mn-breadcrumb-list">
                        <li class="mn-breadcrumb-item"><a asp-action="Index" asp-controller="Home">Trang chủ</a></li>
                        <li class="mn-breadcrumb-item active">Sản phẩm</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xxl-12">
        <!-- Shop section -->
        <section class="mn-shop padding-tb-30">
            <div class="row">
                <div class="mn-shop-rightside col-lg-9 col-md-12">
                    <form method="get" asp-controller="Product" asp-action="List">
                        <div class="mn-pro-list-top d-flex">
                            <div class="col-md-6 mn-grid-list">
                                <div class="mn-gl-btn">
                                    <button class="grid-btn btn-grid active">
                                        <i class="ri-gallery-view-2"></i>
                                    </button>
                                    <button class="grid-btn btn-list">
                                        <i class="ri-list-check-2"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6 mn-sort-select">
                                <div class="mn-select-inner">
                                    <select name="Sort" id="mn-select">
                                        <option  disabled>Sắp xếp</option>
                                        <option value="Price_Desc" selected="@(searchData.Sort == "Price_Desc")">Giá:tăng dần</option>
                                        <option value="Price_Asc" selected="@(searchData.Sort == "Price_Asc")">Giá:giảm dần</option>
                                        <option value="Name_Asc" selected="@(searchData.Sort == "Name_Asc")">Tên: A-Z</option>
                                        <option value="Name_Desc" selected="@(searchData.Sort == "Name_Desc")">Tên: Z-A</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                    </form>

                    <div class="shop-pro-content">
                        <div class="shop-pro-inner">
                            <div class="row">
                              

                                @foreach (var product in products.Items)
                                {
                                    <div class="col-md-4 col-sm-6 col-xs-6 m-b-24 mn-product-box pro-gl-content">
                                        <div class="mn-product-card">
                                            <div class="mn-product-img">

                                                <div class="mn-img">
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id" class="image">
                                                        <img src="@product.Image" asp-append-version="true">
                                                    </a>
                                                    <div class="mn-pro-loader"></div>
                                                    <div class="mn-options">
                                                        <ul>
                                                            <li>
                                                                <a href="javascript:void(0)" data-tooltip
                                                                   title="Xem nhanh"
                                                                   data-link-action="quickview"
                                                                   data-bs-toggle="modal"
                                                                   data-bs-target="#quickview_modal">
                                                                    <i class="ri-eye-line"></i>
                                                                </a>
                                                            </li>

                                                            <li>
                                                                <a href="javascript:void(0)" data-tooltip
                                                                   title="Thêm giỏ hàng" class="mn-add-cart">

                                                                    <form asp-action="AddToCart" asp-controller="Cart" method="post">
                                                                        <input type="hidden" name="ProductId" value="@product.Id" />
                                                                        <input type="hidden" name="Quantity" value="1" />
                                                                        <button style="border:none;background-color:transparent" type="submit">
                                                                            <i class="ri-shopping-cart-line"></i>
                                                                        </button>
                                                                    </form>
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mn-product-detail">
                                                <div class="cat">
                                                    <a asp-controller="Product" asp-action="List" asp-route-categoryId="@product.CategoryId">@product.CategoryName</a>
                                                    <ul>
                                                        <li>Size: @string.Join(", ", product.Sizes)</li>

                                                    </ul>
                                                </div>
                                                <h5>
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id">
                                                        @product.Name
                                                    </a>
                                                </h5>
                                                <p class="mn-info">

                                                </p>
                                                <div class="mn-price">
                                                    <div class="mn-price-new">@product.PriceString</div>
                                                    <div class="mn-price-old">@product.PriceString</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="mn-pro-pagination m-b-15">
                            <ul class="mn-pro-pagination-inner">
                                @for (var i = 1; i <= products.TotalPage; i++)
                                {
                                    <li>
                                        <a class="@(searchData.Page == i ? "active" : "")"
                                           asp-controller="Product"
                                           asp-action="List"
                                           asp-route-page="@i">
                                            @i
                                        </a>
                                    </li>
                                }

                            </ul>
                        </div>
                    </div>
                </div>
                <!-- Sidebar Area Start -->
                @Html.Partial("_SidebarProduct")
            </div>
        </section>
    </div>
</div>

<script>
    document.getElementById("mn-select").addEventListener("change", function () {
        this.form.submit();
    });

</script>
<style>
    /* GRID */
.shop-pro-inner .row {
    display: flex;
    flex-wrap: wrap;
}

.mn-product-box {
    display: flex;
}

/* CARD */
.mn-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
}

/* IMAGE FIX (QUAN TRỌNG) */
.mn-img {
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.mn-img img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* đổi cover nếu muốn đầy khung */
}

/* CONTENT */
.mn-product-detail {
    flex: 1;
    display: flex;
    flex-direction: column;
}

/* TITLE */
.mn-product-detail h5 a {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 48px;
}

/* PRICE */
.mn-price {
    margin-top: auto;
}

</style>

