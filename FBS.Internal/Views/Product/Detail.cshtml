@using FBS.Application.DataTranferObjects.Cart
@using FBS.Application.DataTranferObjects.Products

@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fullName = User.Identity.IsAuthenticated ? User.Identity.Name : "";
    var productData = (ProductDto)ViewData["Product"] ?? new ProductDto();
    var randomProducts = (List<ProductDto>)ViewData["RandomProducts"] ?? new List<ProductDto>();
}

@model CartItemDto

<div class="mn-breadcrumb m-b-30">
    <div class="row">
        <div class="col-12">
            <div class="row gi_breadcrumb_inner">
                <div class="col-md-6 col-sm-12">
                    <h2 class="mn-breadcrumb-title">Chi tiết sản phẩm</h2>
                </div>
                <div class="col-md-6 col-sm-12">
                    <ul class="mn-breadcrumb-list">
                        <li class="mn-breadcrumb-item"><a asp-action="Index" asp-controller="Home">Trang chủ</a></li>
                        <li class="mn-breadcrumb-item active">Chi tiết sản phẩm</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xxl-12">
        <section class="mn-single-product">
            <div class="row">
                <div class="mn-pro-rightside mn-common-rightside col-lg-9 col-md-12 m-b-15">

                    <div class="single-pro-block">
                        <div class="single-pro-inner">
                            <div class="row">

                         
                                <div class="single-pro-img">
                                    <div class="single-product-scroll">

                                   
                                        <div class="single-product-cover">

                                            <div class="single-slide zoom-image-hover">
                                                <img class="img-responsive"
                                                     src="/theme/client/img/product/@productData.Image"
                                                     alt="@productData.Name" />
                                            </div>

                                          
                                            @if (productData.SubImages != null)
                                            {
                                                foreach (var img in productData.SubImages)
                                                {
                                                    <div class="single-slide zoom-image-hover">
                                                        <img class="img-responsive"
                                                             src="/theme/client/img/product/@img"
                                                             alt="@productData.Name" />
                                                    </div>
                                                }
                                            }
                                        </div>

                                        
                                        <div class="single-nav-thumb">

                                            <div class="single-slide">
                                                <img class="img-responsive"
                                                     src="/theme/client/img/product/@productData.Image"
                                                     alt="@productData.Name" />
                                            </div>

                                            @if (productData.SubImages != null)
                                            {
                                                foreach (var img in productData.SubImages)
                                                {
                                                    <div class="single-slide">
                                                        <img class="img-responsive"
                                                             src="/theme/client/img/product/@img"
                                                             alt="@productData.Name" />
                                                    </div>
                                                }
                                            }

                                        </div>

                                    </div>
                                </div>

                              
                                <div class="single-pro-desc m-t-991">
                                    <div class="single-pro-content">

                                        <h5 class="mn-single-title">
                                            @productData.Name
                                        </h5>

                                        <div class="mn-single-price-stoke">
                                            <div class="mn-single-price">
                                                @if (productData.Discount.HasValue && productData.Discount.Value > 0)
                                                {
                                                  
                                                    <div class="price-original-row">
                                                        <span class="price-original">@productData.PriceString&nbsp;đ</span>
                                                        <span class="price-discount">-@productData.Discount%</span>
                                                    </div>

                                                  
                                                    <div class="price-final">@productData.PriceAfterDiscountString&nbsp;đ</div>
                                                }
                                                else
                                                {
                                                    <div class="price-final">@productData.PriceString&nbsp;đ</div>
                                                }
                                            </div>
                                        </div>


                                        <div class="mn-single-desc">
                                            @productData.Description
                                        </div>

                                        
                                        <form asp-action="AddToCart" asp-controller="Cart" method="post" class="">
                                            <div class="mn-pro-variation mb-0">
                                                <div class="mn-pro-variation-inner mn-pro-variation-size m-b-24">
                                                    <span>Size</span>
                                                    <div class="mn-pro-variation-content">
                                                        <div class="size-list">

                                                            @{
                                                                var sizeOrder = new List<string> { "XS", "S", "M", "L", "XL", "2XL", "3XL" };

                                                                var orderedSizes = productData.Sizes
                                                                .Where(s => !string.IsNullOrWhiteSpace(s))
                                                                .OrderBy(s =>
                                                                {
                                                                    // size  39, 40, 41
                                                                    if (int.TryParse(s, out var num))
                                                                        return num;

                                                                    // size S, M, L
                                                                    var index = sizeOrder.IndexOf(s.ToUpper());
                                                                    return index >= 0 ? 1000 + index : 2000;
                                                                })
                                                                .ToList();
                                                            }
                                                            @foreach (var s in orderedSizes)
                                                            {
                                                                <label class="size-item">
                                                                    <input type="radio"
                                                                           asp-for="Size"
                                                                           value="@s"
                                                                           class="size-radio"
                                                                           style="display:none;" />
                                                                    <span class="size-text">@s</span>
                                                                </label>
                                                            }


                                                        </div>

                                                        <div id="sizeError" class="size-error">
                                                            <i class="ri-alert-line"></i>
                                                            <span>Vui lòng chọn size</span>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="w-100 mn-single-qty d-flex align-items-start gap-3">

                                                
                                                <div class="qty-wrapper">

                                                    <div class="qty-plus-minus">
                                                        <input class="qty-input" type="text" asp-for="Quantity" value="1">
                                                    </div>

                                                  
                                                    <div id="contactWarning"
                                                         class="alert alert-warning mt-2"
                                                         style="display:none; max-width:260px;">
                                                         Số lượng lớn hơn <b>10 sản phẩm</b>.<br />
                                                        Vui lòng <b>liên hệ shop</b> để được hỗ trợ.
                                                    </div>

                                                </div>
                                             

                                                <form asp-action="AddToCart"
                                                      asp-controller="Cart"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="ProductId" value="@Model.ProductId" />

                                                    <input type="hidden" name="Size" id="SelectedSize" />
                                                    <input type="hidden" name="Quantity" id="Quantity" value="1" />

                                                    <form asp-action="AddToCart"
                                                          asp-controller="Cart"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                      
                                                        <input type="hidden" name="ProductId" value="@Model.ProductId" />

                                                     
                                                        <input type="hidden" name="Size" id="SelectedSize" />

                                                     
                                                        <input type="hidden" name="Quantity" id="Quantity" value="1" />

                                                        <button type="submit" class="btn btn-primary mn-btn-2">
                                                            Thêm vào giỏ
                                                        </button>
                                                    </form>
                                                </form>


                                            </div>

                                        </form>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                   
                 
                    <div class="mn-single-pro-tab">
                        <div class="mn-single-pro-tab-wrapper">

                            <ul class="nav nav-tabs" id="productTab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="details-tab"
                                            data-bs-toggle="tab" data-bs-target="#details-pane"
                                            type="button" role="tab">
                                        Thông Tin Chi Tiết
                                    </button>
                                </li>

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="review-tab"
                                            data-bs-toggle="tab" data-bs-target="#review-pane"
                                            type="button" role="tab">
                                        Đánh Giá
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content mt-4">

                              
                                <div class="tab-pane fade show active" id="details-pane" role="tabpanel">

                                 
                                    <div class="product-description mb-4">
                                        @Html.Raw((productData.Detail ?? "").Replace("\n", "<br />"))
                                    </div>


                               
                                    <h5 class="mb-3 fw-bold">Hình ảnh chi tiết</h5>

                                    <div class="row">

                                     

                                       
                                        @if (productData.SubImages != null)
                                        {


                                            foreach (var img in productData.SubImages.Distinct().Take(4))

                                            {
                                                <div class="col-md-6 mb-3">
                                                    <img src="/theme/client/img/product/@img"
                                                         class="img-fluid rounded shadow-sm w-100" />
                                                </div>
                                            }
                                        }

                                    </div>


                                </div>

                              
                            
                                <div class="tab-pane fade" id="review-pane" role="tabpanel">
                                    <div class="row p-3">

                                        
                                        <div class="mn-t-review-wrapper mb-4">
                                            @if (productData.Reviews.Any())
                                            {
                                                @foreach (var review in productData.Reviews)
                                                {
                                                    <div class="p-3 mb-3 bg-white rounded shadow-sm border">
                                                        <div class="d-flex justify-content-between">
                                                            <div class="fw-bold text-primary">@review.FullName</div>
                                                        </div>
                                                        <div class="text-muted mt-1">@review.Message</div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted">Chưa có đánh giá nào.</p>
                                            }
                                        </div>

                                      
                                        <div class="mn-ratting-content p-4 bg-white rounded shadow-sm border">
                                            <h4 class="fw-bold mb-3">Thêm đánh giá</h4>

                                            <form asp-action="Review" asp-controller="Product" method="post">
                                                <input type="hidden" name="ProductId" value="@productData.Id" />

                                           
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Họ tên</label>

                                                    @if (User.Identity.IsAuthenticated)
                                                    {
                                                        <input name="FullName"
                                                               type="text"
                                                               value="@fullName"
                                                               class="form-control rounded-pill"
                                                               readonly />
                                                    }
                                                    else
                                                    {
                                                        <input name="FullName"
                                                               type="text"
                                                               placeholder="Nhập họ tên"
                                                               class="form-control rounded-pill" />
                                                    }
                                                </div>

                                              
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Nội dung</label>
                                                    <textarea name="Message"
                                                              class="form-control rounded-4"
                                                              rows="4"
                                                              placeholder="Viết nội dung đánh giá..."></textarea>
                                                </div>

                                            
                                                <button class="btn btn-primary rounded-pill px-4 py-2 fw-bold" type="submit">
                                                    Gửi đánh giá
                                                </button>

                                            </form>
                                        </div>

                                    </div>
                                </div>



                            </div>
                        </div>
                    </div>


                    
                    <section class="mn-new-product p-tb-15">
                        <div class="mn-title">
                            <h2>Sản Phẩm Mới</h2>
                        </div>

                        <div class="mn-product owl-carousel">

                            @foreach (var item in randomProducts)
                            {
                                <div class="mn-product-card">

                                    <div class="mn-product-img">
                                        <div class="lbl"><span class="trending">Mới</span></div>

                                        <div class="mn-img">
                                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id">
                                                <img class="main-img" src="@item.Image" alt="@item.Name">
                                                <img class="hover-img" src="@item.Image" alt="@item.Name">
                                            </a>
                                        </div>
                                    </div>

                                    <div class="mn-product-detail">
                                        <div class="cat">
                                            <a asp-controller="Product"
                                               asp-action="List"
                                               asp-route-categoryId="@item.CategoryId">
                                                @item.CategoryName
                                            </a>


                                            <ul>
                                                <li>Size: @string.Join(", ", item.Sizes)</li>
                                            </ul>
                                        </div>

                                        <h5>
                                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id">
                                                @item.Name
                                            </a>
                                        </h5>

                                        <div class="mn-price">
                                            <div class="mn-price-new">@item.PriceString</div>
                                            <div class="mn-price-old">@item.PriceString</div>
                                        </div>
                                    </div>

                                </div>
                            }

                        </div>
                    </section>

                </div>

             
                @Html.Partial("_SidebarProduct")

            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            
            const form = document.getElementById("addToCartForm");
            const sizeItems = document.querySelectorAll(".size-item");
            const hiddenSize = document.getElementById("SelectedSize");
            const sizeError = document.getElementById("sizeError");

            const qtyInput = document.querySelector(".qty-input");
            const addToCartBtn = document.querySelector(".mn-add-cart");
            const warningBox = document.getElementById("contactWarning");

           
            sizeItems.forEach(item => {
                item.addEventListener("click", () => {
                    sizeItems.forEach(i => i.classList.remove("active"));
                    item.classList.add("active");

                    hiddenSize.value = item.querySelector("input").value;

                    sizeError.style.display = "none";
                    sizeError.classList.remove("shake");
                });
            });

            
            function checkQuantity() {
                const qty = parseInt(qtyInput.value || 0);

                if (qty > 10) {
                    warningBox.style.display = "block";
                    addToCartBtn.disabled = true;
                    addToCartBtn.classList.add("disabled");
                } else {
                    warningBox.style.display = "none";
                    addToCartBtn.disabled = false;
                    addToCartBtn.classList.remove("disabled");
                }
            }

            if (qtyInput) {
                qtyInput.addEventListener("input", checkQuantity);
            }

          
            if (form) {
                form.addEventListener("submit", function (e) {

                 
                    if (!hiddenSize.value) {
                        e.preventDefault();

                        sizeError.style.display = "flex";
                        sizeError.classList.add("shake");

                        sizeError.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });
                        return;
                    }

                    
                    const qty = parseInt(qtyInput.value || 0);
                    if (qty > 10) {
                        e.preventDefault();
                        alert("Đơn hàng trên 10 sản phẩm. Vui lòng liên hệ shop.");
                        return;
                    }
                });
            }

        });
    </script>
}




<style>
    .size-error {
        display: none;
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #fff1f2;
        color: #dc2626;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        box-shadow: 0 4px 12px rgba(220,38,38,0.15);
        animation: shake 0.25s ease-in-out;
    }

        .size-error i {
            font-size: 18px;
        }

    @@keyframes shake {
        0%

    {
        transform: translateX(0);
    }

    25% {
        transform: translateX(-4px);
    }

    50% {
        transform: translateX(4px);
    }

    75% {
        transform: translateX(-4px);
    }

    100% {
        transform: translateX(0);
    }

    }

    
    .mn-product.owl-carousel .owl-stage {
        display: flex;
        align-items: stretch;
    }

 
    .mn-product.owl-carousel .owl-item {
        display: flex;
    }

   
    .mn-product-card {
        background: #fff;
        border-radius: 18px;
        padding: 14px;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
    }

    
    .mn-product-img {
        position: relative;
        padding: 8px;
    }

    .mn-img {
        width: 100%;
        aspect-ratio: 1 / 1;
        background: #f4f6f8;
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        
        .mn-img img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

  
    .mn-product-detail {
        flex: 1; 
        display: flex;
        flex-direction: column;
        padding-top: 8px;
    }

        /* giới hạn tên */
        .mn-product-detail h5 a {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 44px;
        }

   
    .mn-price {
        margin-top: auto; 
        display: flex;
        gap: 10px;
    }
    
    .mn-price,
    .mn-price-new,
    .mn-price-old {
        display: flex;
        align-items: baseline; 
        gap: 2px;
    }


    .mn-price-new {
        font-size: 17px;
        font-weight: 800;
        color: #111827;
        white-space: nowrap; 
    }

   
        .mn-price-new::after {
            content: "đ";
            font-size: 12px;
            font-weight: 600;
            margin-left: 2px;
        }


    .mn-price-old {
        font-size: 13px;
        color: #9ca3af;
        text-decoration: line-through;
        white-space: nowrap;
    }

        .mn-price-old::after {
            content: "đ";
            font-size: 11px;
            margin-left: 2px;
        }

    .qty-wrapper {
        display: flex;
        flex-direction: column;
    }

    #contactWarning {
        font-size: 14px;
        line-height: 1.4;
    }

    .mn-single-price {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    
    .price-original-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 4px;
    }

    .price-original {
        text-decoration: line-through;
        color: #a0a0a0;
        font-size: 1rem;
    }

    .price-discount {
        background-color: #ff4d4f;
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 2px 6px;
        border-radius: 6px;
        text-transform: uppercase;
    }

 
    .price-final {
        color: #28a745;
        font-weight: bold;
        white-space: nowrap;
        ;
        font-weight: 700;
        font-size: 1.4rem;
    }

 
    @@media (max-width: 576px) {
        .price-original-row

    {
        flex-wrap: wrap;
        gap: 6px;
    }

    }
</style>



