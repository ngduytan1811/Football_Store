<!DOCTYPE html>
<html lang="vi" dir="ltr">

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="keywords"
		  content="ecommerce, store, mart, fashion, grocery, super store, market, organic food, super market">
	<meta name="description" content="Best multipurpose ecommerce html template for your online store.">
	<meta name="author" content="Maraviya Infotech">

	<title>Thoc Store</title>

	<!-- App favicon -->
	<link rel="shortcut icon" href="~/theme/client/img/favicon/favicon.png">

	<!-- Icon CSS -->
	<link href="~/theme/client/css/vendor/materialdesignicons.min.css" rel="stylesheet">
	<link href="~/theme/client/css/vendor/remixicon.css" rel="stylesheet">
	<!-- Vendor -->
	<link href="~/theme/client/css/vendor/bootstrap.min.css" rel="stylesheet">
	<link href="~/theme/client/css/vendor/animate.min.css" rel="stylesheet">
	<link href="~/theme/client/css/vendor/owl.carousel.min.css" rel="stylesheet">
	<link href="~/theme/client/css/vendor/slick.min.css" rel="stylesheet">
	<link href="~/theme/client/css/vendor/swiper-bundle.min.css" rel="stylesheet">
	<link href="~/theme/client/css/vendor/nouislider.css" rel="stylesheet">

	<link id="mainCss" href="~/theme/client/css/style.css" rel="stylesheet">
</head>

<body data-mn-mode="light">

	<main class="wrapper sb-default">

		<div id="mn-overlay">
			<div class="loader">
				<img src="~/theme/client/img/logo/loader.png" alt="loader">
				<span class="shape"></span>
			</div>
		</div>

		<!-- Sidebar -->
		@Html.Partial("_Sidebar")

		<!-- Header -->
		@Html.Partial("_Header")

		<!-- Main Content -->
		<div class="mn-main-content">
			@RenderBody()
			
		</div>

		<!-- Footer -->
		@Html.Partial("_Footer")
		<!-- Cart sidebar Start -->
		@Html.Partial("_CartSidebar")

	</main>

	<!-- Vendor Custom -->
	<script src="~/theme/client/js/vendor/jquery-3.7.1.min.js"></script>
	<script src="~/theme/client/js/vendor/bootstrap.bundle.min.js"></script>
	<script src="~/theme/client/js/vendor/owl.carousel.min.js"></script>
	<script src="~/theme/client/js/vendor/slick.min.js"></script>
	<script src="~/theme/client/js/vendor/swiper-bundle.min.js"></script>
	<script src="~/theme/client/js/vendor/countdownTimer.js"></script>
	<script src="~/theme/client/js/vendor/infiniteslidev2.js"></script>
	<script src="~/theme/client/js/vendor/nouislider.js"></script>
	<script src="~/theme/client/js/vendor/smoothscroll.min.js"></script>
	<script src="~/theme/client/js/vendor/jquery.zoom.min.js"></script>

	<script src="~/theme/client/js/main.js"></script>
</body>

</html>