@using FBS.Application.DataTranferObjects.Cart
@using System.Globalization
@{
	var cart = (List<CartItemDto>)ViewData["Cart"] ?? new List<CartItemDto>();
	var subTotal = cart.Any() ? cart.Sum(x => x.Price) : 0;
}
<div class="mn-side-cart-overlay"></div>
<div id="mn-side-cart" class="mn-side-cart">
	<div class="mn-cart-inner">
		<div class="mn-cart-top">
			<div class="mn-cart-title">
				<span class="cart_title">Giỏ hàng</span>
				<a href="javascript:void(0)" class="mn-cart-close">
					<i class="ri-close-line"></i>
				</a>
			</div>
			<ul class="mn-cart-pro-items">
				@foreach(var item in cart)
				{
					<li class="cart-sidebar-list">
						<a asp-action="Detail" asp-controller="Product" asp-route-id="@item.ProductId" class="mn-pro-img">
							<img src="~/theme/client/img/product/11.jpg"
								 alt="product">
						</a>
						<div class="mn-pro-content">
							<a asp-action="Detail" asp-controller="Product" asp-route-id="@item.ProductId" class="cart-pro-title">@item.ProductName x @item.Quantity</a>
							<span class="cart-price"><span>@item.PriceString</span> </span>
						</div>
					</li>
				}
			</ul>
		</div>
		<div class="mn-cart-bottom">
			<div class="cart-sub-total">
				<table class="table cart-table">
					<tbody>
						<tr>
							<td class="text-left">Tạm tính :</td>
							<td class="text-right">@subTotal.Value.ToString("C", new CultureInfo("vi-VN"))</td>
						</tr>
						<tr>
							<td class="text-left">Tổng tiền :</td>
							<td class="text-right primary-color">@subTotal.Value.ToString("C", new CultureInfo("vi-VN"))</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="cart_btn">
				<a asp-action="Index" asp-controller="Cart" class="mn-btn-1"><span>Giỏ hàng<i class="ri-arrow-right-s-line"></i></span></a>
				<a asp-action="Checkout" asp-controller="Cart" class="mn-btn-2">
					<span>
						Thanh toán<i class="ri-arrow-right-s-line"></i>
					</span>
				</a>
			</div>
		</div>
	</div>
</div>