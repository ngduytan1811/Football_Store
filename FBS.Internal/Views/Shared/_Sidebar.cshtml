<div class="mn-sidebar-overlay"></div>
<div class="mn-sidebar">
	<div class="mn-sidebar-body">
		<button type="button" class="side-close" title="Close"></button>
		<ul class="mn-sb-list">
			<li class="mn-sb-title condense"><span>Danh mục</span></li>
			@foreach (var item in ViewBag.Categories)
			{
				<li class="mn-sb-item sb-drop-item">
					<a href="javascript:void(0)" class="mn-drop-toggle">
						<span class="condense">@item.Name<i class="drop-arrow ri-arrow-down-s-line"></i></span>
					</a>
					<ul class="mn-sb-drop">
						@foreach (var subItem in item.Items)
						{
							<li class="list">
								<a asp-route-categoryId="@subItem.Id" asp-action="List" asp-controller="Product" class="mn-page-link drop">@subItem.Name</a>
						</li>							
						}
					</ul>
				</li>
			}
		</ul>
	</div>
</div>